  // shop directly (in person / by phone). Such a booking has no FastQue customer account
  // (customerId NULL, guestName set) — enforced by a CHECK constraint in the migration.
  IN_SHOP
}

// External channels are only attached through a server-issued salon campaign token; clients may
// never write arbitrary social/chat attribution into the operational BookingSource field.
enum BookingAttributionCampaignSource {
  FACEBOOK
  INSTAGRAM

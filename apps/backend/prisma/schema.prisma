  plan           Plan        @relation(fields: [planId], references: [id])
  entitlementKey String
  entitlement    Entitlement @relation(fields: [entitlementKey], references: [key])
  value          String

  @@id([planId, entitlementKey])
  @@map("plan_entitlements")
}

// ---------- Customer Premium plans & AI credits (Premium phase) ----------
// Deliberately NOT the same concept as Plan/Entitlement/PlanEntitlement above, which is salon
// (B2B) subscription billing — inert in V1, unrelated to this. This is a customer-facing (B2C)
// annual plan that grants AI Style Advisor credits. Kept as fully separate models rather than
// extended/renamed from the salon Plan table to avoid conflating two different billing contexts
// (a salon's platform tier vs. a customer's AI-credit allowance) under one schema concept.

enum CustomerSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// Every balance-affecting event on a CustomerSubscription's AI credits, for auditability (never
// contains customer photos, image bytes, or API keys — see AiCreditService).
enum AiCreditTransactionType {
  ALLOCATION
  RESERVATION
  CONSUMPTION
  RELEASE
  MANUAL_ADJUSTMENT
}

// `id` is a stable, human-readable string ("basic" | "pro" | "max"), not a uuid — same convention
// as packages/shared's HAIRSTYLE_CATALOG: a small, fixed, code-referenced catalog, not open-ended
// data. Single authoritative source for price/credits — PremiumPlansService reads this table
// rather than any value being hard-coded elsewhere.
model CustomerPremiumPlan {
  id               String   @id
  name             String
  priceInr         Decimal  @db.Decimal(10, 2)
  aiCreditsPerYear Int
  isPopular        Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  subscriptions CustomerSubscription[]

  @@map("customer_premium_plans")
}

// One row per purchased/activated annual period. Credits are scoped to the period they were
// granted in (aiCreditsAllocated is a snapshot taken at activation, immune to later plan-price/
// credit edits) — deliberately no rollover/carry-forward logic into a future period, per the
// explicit "keep this simple and auditable" instruction for this phase.
model CustomerSubscription {
  id          String                     @id @default(uuid())
  userId      String
  user        User                       @relation(fields: [userId], references: [id])
  planId      String
  plan        CustomerPremiumPlan        @relation(fields: [planId], references: [id])
  status      CustomerSubscriptionStatus @default(ACTIVE)
  periodStart DateTime                   @default(now())
  periodEnd   DateTime

  aiCreditsAllocated Int
  // Reserved = credits held for an in-flight generation request (not yet succeeded or failed).
  // Consumed = permanently spent on a successful generation. Available = allocated - reserved -
  // consumed; see AiCreditService.hasAvailableCredit. Both are maintained by AiCreditService only,
  // inside a per-subscription-locked transaction (see bookings.service.ts's advisory-lock
  // pattern) — never written to directly by any controller.
  aiCreditsReserved  Int @default(0)
  aiCreditsConsumed  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditTransactions AiCreditTransaction[]

  @@index([userId, status])
  @@map("customer_subscriptions")
}

model AiCreditTransaction {
  id             String                  @id @default(uuid())
  subscriptionId String
  subscription   CustomerSubscription    @relation(fields: [subscriptionId], references: [id])
  type           AiCreditTransactionType
  amount         Int
  note           String?
  createdAt      DateTime                @default(now())

  @@index([subscriptionId, createdAt])
  @@map("ai_credit_transactions")
}

// Issue #13 Mission L (cross-agent handoff with Codex, Issue #10 comment 5522610801): the minimal
// device-registration half of a real OS push pipeline. One row per installed app instance
// (identified by its Expo push token, not by device hardware id — a reinstall gets a new token
// and a new row). expoPushToken is unique and reassignable: if a different user later logs into
// the same physical device/app-install, PushDeviceService.register() reassigns the SAME token row
// to the new userId rather than leaving a stale registration pointing at the previous account.
model PushDevice {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  expoPushToken String   @unique
  platform      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("push_devices")
}

// ---------- First-party website visitor measurement ----------

// One durable row per browser/device identity generated by FastQue web. visitorKey is a SHA-256
// digest of the browser UUID; no IP address, user-agent, email, phone or other direct identity is
// persisted. This intentionally measures unique browsers/devices from rollout forward instead of
// pretending historical traffic can be reconstructed exactly.
model SiteVisitor {
  visitorKey  String   @id
  firstSeenAt DateTime @default(now())

  @@map("site_visitors")
}

// ---------- Owner operations: invoicing & notification delivery ----------
//
// Everything below is additive. Money is Decimal(12,2) like the rest of the schema; tax uses an
// integer basis-point rate (1800 = 18.00%) so no calculation ever touches a float.

enum InvoiceStatus {
  ISSUED
  VOID
}

enum InvoiceSourceType {
  BOOKING
  QUEUE_ENTRY
}

enum InvoiceTaxMode {
  EXCLUSIVE
  INCLUSIVE
}

enum InvoicePaymentKind {
  PAYMENT
  REFUND
}

// How the SHOP says it received the money. FastQue does not observe cash/UPI settlement, so every
// InvoicePayment row is a shop-recorded fact (who recorded it and when is stored), never an
// automatically inferred one — displaying a payment QR is not proof of payment.
enum InvoicePaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  GAVE_UP
  SKIPPED
}

// Synthetic operational examples stay in a private document, separate from real salon ledgers.
enum OwnerDemoWorkspaceAuditAction {
  IMPORTED
  REUSED
  DELETED
}

// Per-salon invoice identity. Only configured values are ever printed: no GSTIN is invented, and
// tax is applied only when the owner has enabled it AND supplied a rate. gstin is format-checked
// at write time but NOT verified against the GST portal.
model SalonBillingProfile {
  salonId             String         @id
  salon               Salon          @relation(fields: [salonId], references: [id])
  legalName           String?        @db.VarChar(160)
  billingAddress      String?        @db.VarChar(300)
  contactPhone        String?        @db.VarChar(32)
  contactEmail        String?        @db.VarChar(160)
  gstin               String?        @db.VarChar(15)
  taxEnabled          Boolean        @default(false)
  taxLabel            String         @default("GST") @db.VarChar(20)
  taxRateBps          Int?
  taxMode             InvoiceTaxMode @default(EXCLUSIVE)
  invoicePrefix       String         @default("INV") @db.VarChar(8)
  // Next per-salon sequence number. Claimed with one atomic UPDATE ... RETURNING inside the
  // issuing transaction, so two concurrent issuances can never receive the same number.
  nextInvoiceSequence Int            @default(1)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("salon_billing_profiles")
}

model Invoice {
  id              String            @id @default(uuid())
  salonId         String
  salon           Salon             @relation(fields: [salonId], references: [id])
  sequence        Int
  number          String            @db.VarChar(32)
  sourceType      InvoiceSourceType
  bookingId       String?
  booking         Booking?          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  // Plain ids (no relation): the queue visit and the customer account are authorization/lookup
  // keys here, and keeping them relation-free leaves the QueueEntry and User models untouched.
  queueEntryId    String?
  customerId      String?
  customerName    String?           @db.VarChar(120)
  customerPhone   String?           @db.VarChar(32)
  staffName       String?           @db.VarChar(120)
  currency        String            @db.VarChar(3)
  subtotal        Decimal           @db.Decimal(12, 2)
  discountTotal   Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal           @default(0) @db.Decimal(12, 2)
  total           Decimal           @db.Decimal(12, 2)
  // Snapshots of the configuration in force when issued — later profile edits never rewrite an
  // issued invoice.
  taxLabel        String?           @db.VarChar(20)
  taxRateBps      Int?
  taxMode         InvoiceTaxMode?
  sellerLegalName String            @db.VarChar(160)
  sellerGstin     String?           @db.VarChar(15)
  sellerAddress   String?           @db.VarChar(300)
  sellerPhone     String?           @db.VarChar(32)
  sellerEmail     String?           @db.VarChar(160)
  serviceDate     DateTime
  status          InvoiceStatus     @default(ISSUED)
  issuedAt        DateTime          @default(now())
  issuedByUserId  String
  idempotencyKey  String?           @unique
  voidedAt        DateTime?
  voidedByUserId  String?
  voidReason      String?           @db.VarChar(300)

  lines    InvoiceLine[]
  payments InvoicePayment[]

  @@unique([salonId, sequence])
  @@unique([salonId, number])
  @@index([salonId, issuedAt])
  @@index([customerId, issuedAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId   String?
  description String  @db.VarChar(200)
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  sortOrder   Int

  @@index([invoiceId])
  @@map("invoice_lines")
}

model InvoicePayment {
  id               String               @id @default(uuid())
  invoiceId        String
  invoice          Invoice              @relation(fields: [invoiceId], references: [id])
  salonId          String
  kind             InvoicePaymentKind
  method           InvoicePaymentMethod
  amount           Decimal              @db.Decimal(12, 2)
  reference        String?              @db.VarChar(80)
  note             String?              @db.VarChar(200)
  recordedByUserId String
  recordedAt       DateTime             @default(now())
  idempotencyKey   String?              @unique

  @@index([invoiceId])
  @@index([salonId, recordedAt])
  @@map("invoice_payments")
}

// One row per (event, channel, recipient): the delivery ledger for notifications whose delivery
// must be idempotent and observable (shop-initiated booking cancellation first). `dedupeKey` is
// UNIQUE, so a retried request or double-click can never create a second notification. PUSH
// attempts that fail transiently are retried by NotificationDeliveryService.sweep with
// exponential backoff, then marked GAVE_UP — the booking itself is never rolled back for it.
model NotificationDelivery {
  id            String                     @id @default(uuid())
  dedupeKey     String                     @unique
  userId        String
  type          String
  channel       NotificationChannel
  status        NotificationDeliveryStatus @default(PENDING)
  attempts      Int                        @default(0)
  lastError     String?                    @db.VarChar(300)
  nextAttemptAt DateTime?
  payload       Json?
  deepLink      String?
  createdAt     DateTime                   @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

// A private, per-shop synthetic dashboard dataset. It intentionally has no relations to
// bookings, queue entries, customers, invoices, or payments: scheduled jobs, public discovery,
// live booking/queue APIs and real financial reporting cannot consume demo records by accident.
model OwnerDemoWorkspace {
  id              String   @id @default(uuid())
  salonId         String   @unique
  salon           Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  schemaVersion   Int      @default(1)
  payload         Json     @db.JsonB
  createdByUserId String?
  createdBy       User?    @relation("OwnerDemoWorkspaceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("owner_demo_workspaces")
}

// Append-only lifecycle evidence. workspaceId intentionally has no FK so deletion of the
// isolated synthetic payload retains a durable audit event; salon/actor FKs become NULL on delete.
model OwnerDemoWorkspaceAudit {
  id                 String                        @id @default(uuid())
  // Immutable identifiers, intentionally relation-free so deleting a shop/user cannot mutate or
  // block the append-only audit record.
  salonId            String
  actorUserId        String
  workspaceId        String
  action             OwnerDemoWorkspaceAuditAction
  recordCounts       Json                          @db.JsonB
  idempotencyKeyHash String?
  requestHash        String?
  createdAt          DateTime                      @default(now())

  @@unique([salonId, actorUserId, idempotencyKeyHash], map: "owner_demo_workspace_audit_import_idempotency_key")
  @@index([salonId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("owner_demo_workspace_audit")
}

// ---- Contact consent ledger (requirement 13): durable consent evidence, suppression and erasure, provider-free. ----
// No phone number is stored in plaintext: only a keyed hash (HMAC-SHA256 of the E.164 number, key CONTACT_LEDGER_HASH_KEY).
// Nothing here sends anything; invitation dispatch stays blocked behind the provider and approval gates.
model ContactConsentRecord {
  id               String    @id @default(uuid())
  salonId          String
  salon            Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  phoneHash        String    @db.VarChar(64)
  purpose          String    @default("BOOKING_INVITATION") @db.VarChar(32)
  source           String    @db.VarChar(24)
  // When the owner states the contact agreed (never in the future); NOT proof by itself.
  capturedAt       DateTime
  recordedAt       DateTime  @default(now())
  recordedByUserId String
  policyVersion    String    @db.VarChar(40)
  status           String    @default("ACTIVE") @db.VarChar(16)
  withdrawnAt      DateTime?
  expiresAt        DateTime

  @@unique([salonId, phoneHash, purpose])
  @@index([salonId, status, expiresAt])
  @@index([expiresAt])
  @@index([phoneHash])
  @@map("contact_consent_records")
}

// Platform-wide do-not-contact list, keyed by the same hash. Deliberately survives erasure of any consent record: it is the
// minimal data needed to honour an opt-out, and holds no phone number, name or shop.
model ContactSuppression {
  phoneHash       String   @id @db.VarChar(64)
  reason          String   @db.VarChar(24)
  createdAt       DateTime @default(now())
  createdByUserId String?

  @@map("contact_suppressions")
}

// A customer's saved salons (heart on the discovery cards). One row per (customer, salon); the
// unique key prevents duplicates, and both lookups — "my favorites" and "is this salon a favorite" —
// are index-backed.
model CustomerFavorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, salonId])
  @@index([userId, createdAt])
  @@index([salonId])
  @@map("customer_favorites")
}

// Customer dashboard "Recently viewed": one row per (customer, salon), viewedAt bumped on each
// meaningful salon-detail visit (never on card hover). Private to the customer — never exposed to
// salon owners or other customers — and pruned to a configurable cap per customer on write.
model CustomerRecentSalonView {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  salonId  String
  salon    Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@unique([userId, salonId])
  @@index([userId, viewedAt])
  @@index([salonId])
  @@map("customer_recent_salon_views")
}

// ---------- Inventory Phase 2: service consumption ----------

enum ServiceUsageStatus {
  RECORDED
  REVERSED
}

enum ServiceUsageSource {
  MANUAL
  AUTO
}

/// A service's recipe line: which of the salon's inventory categories it uses and how much
/// ("Shaving: shaving cream, 10 ml"). A default product is only deducted without a choice when the
/// salon ticked autoDeduct — a default is never assumed to have been used silently.
model ServiceProductRule {
  id                  String            @id @default(uuid())
  salonId             String
  salon               Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  serviceId           String
  service             Service           @relation(fields: [salonId, serviceId], references: [salonId, id], onDelete: Restrict)
  inventoryCategoryId String
  inventoryCategory   InventoryCategory @relation(fields: [inventoryCategoryId, salonId], references: [id, salonId], onDelete: Restrict)
  quantity            Decimal           @db.Decimal(12, 3)
  unit                InventoryUnit
  defaultProductId    String?
  defaultProduct      InventoryProduct? @relation(fields: [defaultProductId, salonId], references: [id, salonId], onDelete: Restrict)
  autoDeduct          Boolean           @default(false)
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)

  usageItems ServiceUsageItem[]

  @@unique([serviceId, inventoryCategoryId])
  @@index([salonId, serviceId])
  @@map("service_product_rules")
}

/// Products recorded as used for one service in one visit (queue entry). At most one RECORDED row
/// per (queueEntryId, serviceId) — a partial unique index in the migration — so a repeated
/// completion event or a double tap can never deduct twice; a correction reverses it first.
model ServiceUsage {
  id               String             @id @default(uuid())
  salonId          String
  salon            Salon              @relation(fields: [salonId], references: [id], onDelete: Restrict)
  queueEntryId     String
  queueEntry       QueueEntry         @relation(fields: [queueEntryId], references: [id], onDelete: Restrict)
  serviceId        String
  service          Service            @relation(fields: [salonId, serviceId], references: [salonId, id], onDelete: Restrict)
  staffId          String?
  staff            SalonStaff?        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  status           ServiceUsageStatus @default(RECORDED)
  source           ServiceUsageSource @default(MANUAL)
  recordedByUserId String
  recordedBy       User               @relation("ServiceUsageRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  recordedAt       DateTime           @default(now()) @db.Timestamptz(6)
  reversedAt       DateTime?          @db.Timestamptz(6)
  reversedByUserId String?
  reversedBy       User?              @relation("ServiceUsageReversedBy", fields: [reversedByUserId], references: [id], onDelete: Restrict)
  reversalReason   String?            @db.VarChar(300)

  items ServiceUsageItem[]

  @@index([salonId, recordedAt])
  @@index([queueEntryId])
  @@map("service_usages")
}

/// One product taken off stock for a service usage, with what the user entered (10 ml) and what
/// the ledger deducted in the product's own unit (0.051 bottles). Each line owns its ledger entry.
model ServiceUsageItem {
  id                 String              @id @default(uuid())
  usageId            String
  usage              ServiceUsage        @relation(fields: [usageId], references: [id], onDelete: Restrict)
  salonId            String
  productId          String
  product            InventoryProduct    @relation(fields: [productId, salonId], references: [id, salonId], onDelete: Restrict)
  ruleId             String?
  rule               ServiceProductRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  quantity           Decimal             @db.Decimal(12, 3)
  enteredQuantity    Decimal             @db.Decimal(12, 3)
  enteredUnit        InventoryUnit
  movementId         String              @unique
  movement           InventoryMovement   @relation("ServiceUsageMovement", fields: [movementId], references: [id], onDelete: Restrict)
  reversalMovementId String?             @unique
  reversalMovement   InventoryMovement?  @relation("ServiceUsageReversalMovement", fields: [reversalMovementId], references: [id], onDelete: Restrict)

  @@unique([usageId, productId])
  @@index([productId])
  @@map("service_usage_items")
}

// ---------- Inventory Phase 3: predictions and alerts ----------

enum InventoryAlertKind {
  REORDER
  STOCK_OUT
  EXPIRING
  EXPIRED
}

/// A shop's forecasting assumptions. No row = the defaults (5 days delivery, 3 days cushion, orders
/// cover 14 days, alerts on).
model InventorySettings {
  salonId        String   @id
  salon          Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  leadTimeDays   Int      @default(5)
  safetyDays     Int      @default(3)
  coverDays      Int      @default(14)
  alertsEnabled  Boolean  @default(true)
  lastAlertRunAt DateTime? @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@map("inventory_settings")
}

/// One open stock problem (reorder, stock-out, expiring/expired batch). At most one unresolved alert
/// per (shop, dedupeKey) — a partial unique index — so the owner is told once per problem, not every
/// day. It resolves itself when the problem goes away; dismissing only hides it.
model InventoryAlert {
  id                String             @id @default(uuid())
  salonId           String
  salon             Salon              @relation(fields: [salonId], references: [id], onDelete: Restrict)
  productId         String?
  product           InventoryProduct?  @relation(fields: [productId, salonId], references: [id, salonId], onDelete: Restrict)
  kind              InventoryAlertKind
  dedupeKey         String             @db.VarChar(160)
  title             String             @db.VarChar(200)
  detail            String             @db.VarChar(500)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  resolvedAt        DateTime?          @db.Timestamptz(6)
  dismissedAt       DateTime?          @db.Timestamptz(6)
  dismissedByUserId String?

  @@index([salonId, resolvedAt, createdAt])
  @@map("inventory_alerts")
}

// ---------- Employee-to-admin salon onboarding ----------
// A field employee's application to list a salon. Nothing here is public: the master Salon row is
// created only on admin approval (status PENDING, so still invisible to discovery), and publication
// is a separate, recorded admin decision (publishAuthorizedAt). Unknown details stay NULL; the
// workflow never fills in a value nobody supplied.

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  RESUBMITTED
  REJECTED
  APPROVED
  OWNER_INVITED
  AWAITING_OWNER_ACTIVATION
  READY_TO_PUBLISH
  ACTIVE
  SUSPENDED
}

enum OnboardingGender {
  MEN
  WOMEN
  UNISEX
}

enum OnboardingSalonKind {
  BARBER_SHOP
  BEAUTY_SALON
  UNISEX_SALON
  SPA
  OTHER
}

enum OnboardingMediaCategory {
  EXTERIOR
  INTERIOR
  STATIONS
  RECEPTION
  LOGO
  MENU
  OTHER
  ENTRANCE
  INTERIOR_LEFT
  INTERIOR_RIGHT
  WASH_STATIONS
  WAITING_AREA
  EQUIPMENT
  RETAIL_DISPLAY
}

enum OnboardingServiceSource {
  MANUAL
  AI_EXTRACTED
}

enum OnboardingPriceType {
  FIXED
  STARTS_FROM
}

enum OnboardingReviewDecision {
  START_REVIEW
  NOTE
  CORRECTION
  REQUEST_CHANGES
  REJECT
  APPROVE
}

// SENT means the provider accepted the message; CAPTURED_DEV means the development console
// sender logged the link and nothing left the machine. Neither is "delivered".
enum OnboardingInvitationStatus {
  PENDING
  SENT
  CAPTURED_DEV
  FAILED
  DELIVERY_UNAVAILABLE
  ACCEPTED
  REVOKED
}

model SalonOnboardingApplication {
  id                         String               @id @default(uuid())
  // Display reference only ("FQ-ONB-2026-000001"); never used for authorization or public access.
  // Assigned by a Postgres sequence default (see migration 20261119090000_salon_onboarding).
  reference                  String               @unique @default(dbgenerated("(((('FQ-ONB-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('salon_onboarding_reference_seq'::regclass))::text, 6, '0'::text)))"))
  // Incremented on every edit after first submission and on every admin correction, so a review
  // decision records exactly which version it judged.
  version                    Int                  @default(1)
  status                     OnboardingStatus     @default(DRAFT)
  leadId                     String               @unique
  lead                       EmployeeCrmLead      @relation(fields: [leadId], references: [id], onDelete: Restrict)
  salonId                    String?              @unique
  salon                      Salon?               @relation(fields: [salonId], references: [id], onDelete: Restrict)
  assignedEmployeeId         String
  assignedEmployee           EmployeeProfile      @relation(fields: [assignedEmployeeId], references: [id], onDelete: Restrict)
  createdByUserId            String
  createdBy                  User                 @relation("OnboardingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  // Snapshot of the employee's territory at creation; drives read-only sharing between employees.
  territory                  String?              @db.VarChar(120)
  reviewerId                 String?
  reviewer                   User?                @relation("OnboardingReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  // Step 1 - identity
  salonName                  String               @db.VarChar(160)
  genderCategory             OnboardingGender?
  salonKind                  OnboardingSalonKind?
  // Every type the employee ticked; salonKind stays the first one for existing readers.
  salonKinds                 OnboardingSalonKind[] @default([])
  salonKindOther             String?              @db.VarChar(160)
  description                String?              @db.VarChar(2000)
  brandName                  String?              @db.VarChar(160)
  websiteUrl                 String?              @db.VarChar(500)
  instagramUrl               String?              @db.VarChar(500)
  mapsUrl                    String?              @db.VarChar(1000)
  isFranchise                Boolean?
  branchCount                Int?

  // Step 2 - owner / contact (private until the owner account exists)
  ownerName                  String?              @db.VarChar(160)
  ownerPhone                 String?              @db.VarChar(20)
  ownerWhatsapp              String?              @db.VarChar(20)
  ownerEmail                 String?              @db.VarChar(254)
  alternatePhone             String?              @db.VarChar(20)
  managerName                String?              @db.VarChar(160)
  managerPhone               String?              @db.VarChar(20)
  preferredLanguage          String?              @db.VarChar(40)

  // Step 3 - address
  shopNumber                 String?              @db.VarChar(60)
  buildingName               String?              @db.VarChar(160)
  streetAddress              String?              @db.VarChar(300)
  locality                   String?              @db.VarChar(160)
  city                       String?              @db.VarChar(120)
  district                   String?              @db.VarChar(120)
  state                      String?              @db.VarChar(120)
  postalCode                 String?              @db.VarChar(12)
  country                    String?              @db.VarChar(80)
  landmark                   String?              @db.VarChar(200)
  latitude                   Float?
  longitude                  Float?
  // GPS / MAP_PIN / MANUAL: coordinates are only stored with an explicit source.
  coordinatesSource          String?              @db.VarChar(16)
  // CRM 2.0 GPS verification of the salon entrance (device capture). Never public until approval.
  gpsAccuracyMeters          Float?
  gpsCapturedAt              DateTime?
  gpsCapturedById            String?
  locationVerified           Boolean              @default(false)

  // Step 4 - operations
  employeeCount              Int?
  chairCount                 Int?
  activeChairCount           Int?
  maleStaffCount             Int?
  femaleStaffCount           Int?
  walkInsAccepted            Boolean?
  bookingsAccepted           Boolean?
  liveQueueSupported         Boolean?
  appointmentIntervalMinutes Int?
  averageServiceMinutes      Int?
  specialTimings             String?              @db.VarChar(1000)
  // CRM 2.0 operations details
  washStationCount           Int?
  weeklyHolidays             String[]             @default([])
  amenities                  Json?
  qrInstallReady             Boolean?
  inventoryInterest          Boolean?
  ownerTrainingStatus        String?              @db.VarChar(20)

  // Step 7 - verification and consent
  consentContact             Boolean              @default(false)
  consentListing             Boolean              @default(false)
  consentAccuracy            Boolean              @default(false)
  consentAuthorization       Boolean              @default(false)
  consentCapturedAt          DateTime?
  // How the owner's consent was documented (an employee checkbox alone is not proof).
  consentMethod              String?              @db.VarChar(30)
  consentByName              String?              @db.VarChar(120)
  consentByRole              String?              @db.VarChar(40)
  consentEvidence            Json?
  gstin                      String?              @db.VarChar(15)
  businessRegistration       String?              @db.VarChar(200)
  employeeNotes              String?              @db.VarChar(2000)
  openQuestions              String?              @db.VarChar(2000)

  // Admin-only fields
  internalNotes              String?              @db.VarChar(4000)
  photoExceptionReason       String?              @db.VarChar(500)
  photoExceptionById         String?
  // [{ field, message }]: exactly which information needs correction.
  changeRequest              Json?

  firstSubmittedAt           DateTime?
  submittedAt                DateTime?
  reviewStartedAt            DateTime?
  approvedAt                 DateTime?
  approvedById               String?
  approvedBy                 User?                @relation("OnboardingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedVersion            Int?
  rejectedAt                 DateTime?
  rejectionReason            String?              @db.VarChar(1000)
  publishAuthorizedAt        DateTime?
  publishAuthorizedById      String?
  publishedAt                DateTime?
  suspendedAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  hours         SalonOnboardingHours[]
  services      SalonOnboardingService[]
  media         SalonOnboardingMedia[]
  extractions   SalonOnboardingExtraction[]
  reviews       SalonOnboardingReview[]
  statusHistory SalonOnboardingStatusHistory[]
  invitations   SalonOnboardingInvitation[]

  @@index([status, submittedAt])
  @@index([assignedEmployeeId, status])
  @@index([territory, status])
  @@index([city])
  @@index([ownerPhone])
  @@index([ownerEmail])
  @@index([reviewerId, status])
  @@map("salon_onboarding_applications")
}

// One row per weekday (0 = Sunday .. 6 = Saturday, matching OperatingHours). Real TIME columns;
// closesNextDay marks hours that run past midnight (e.g. 18:00 -> 02:00).
model SalonOnboardingHours {
  id            String                     @id @default(uuid())
  applicationId String
  application   SalonOnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  dayOfWeek     Int
  isClosed      Boolean                    @default(false)
  opensAt       DateTime?                  @db.Time(0)
  closesAt      DateTime?                  @db.Time(0)
  closesNextDay Boolean                    @default(false)

  @@unique([applicationId, dayOfWeek])
  @@map("salon_onboarding_hours")
}

model SalonOnboardingService {
  id                   String                     @id @default(uuid())
  applicationId        String
  application          SalonOnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  serviceName          String                     @db.VarChar(120)
  // Lowercased, punctuation-free name + gender; merges duplicates across photos and manual rows.
  normalizedKey        String                     @db.VarChar(160)
  category             String?                    @db.VarChar(80)
  applicableGender     OnboardingGender?
  basePrice            Decimal?                   @db.Decimal(10, 2)
  priceType            OnboardingPriceType        @default(FIXED)
  discountedPrice      Decimal?                   @db.Decimal(10, 2)
  // Never defaulted: a missing duration stays NULL until the employee or owner enters it.
  durationMinutes      Int?
  description          String?                    @db.VarChar(500)
  isActive             Boolean                    @default(true)
  sourceType           OnboardingServiceSource    @default(MANUAL)
  sourceMediaId        String?
  sourceMedia          SalonOnboardingMedia?      @relation(fields: [sourceMediaId], references: [id], onDelete: SetNull)
  sourcePage           Int?
  extractionConfidence Float?
  // Field names the extractor was unsure about (e.g. ["basePrice"]); cleared when confirmed.
  uncertainFields      String[]
  confirmedByEmployee  Boolean                    @default(false)
  sortOrder            Int                        @default(0)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([applicationId, sortOrder])
  @@map("salon_onboarding_services")
}

// Private files. storageKey points into private storage only, never a public URL; files are
// streamed through authenticated API routes.
model SalonOnboardingMedia {
  id               String                     @id @default(uuid())
  applicationId    String
  application      SalonOnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  storageKey       String                     @unique @db.VarChar(300)
  category         OnboardingMediaCategory
  originalFilename String                     @db.VarChar(200)
  mimeType         String                     @db.VarChar(40)
  fileSize         Int
  sha256           String                     @db.VarChar(64)
  width            Int?
  height           Int?
  uploadedById     String
  uploadedBy       User                       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt        DateTime                   @default(now())
  deletedAt        DateTime?

  services    SalonOnboardingService[]
  extractions SalonOnboardingExtraction[]

  // Where/when the photo was taken (with the employee's permission). Private: never copied to
  // public salon photos and never used as the salon's location.
  capturedAt       DateTime?
  captureLatitude  Float?
  captureLongitude Float?
  captureAccuracy  Float?

  @@index([applicationId, category])
  @@index([applicationId, sha256])
  @@map("salon_onboarding_media")
}

model SalonOnboardingExtraction {
  id            String                     @id @default(uuid())
  applicationId String
  application   SalonOnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  mediaId       String
  media         SalonOnboardingMedia       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  provider      String                     @db.VarChar(40)
  status        String                     @db.VarChar(16)
  serviceCount  Int                        @default(0)
  errorCode     String?                    @db.VarChar(60)
  result        Json?
  requestedById String
  createdAt     DateTime                   @default(now())

  @@index([applicationId, createdAt])
  @@map("salon_onboarding_extractions")
}

model SalonOnboardingReview {
  id                 String                     @id @default(uuid())
  applicationId      String
  application        SalonOnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId         String
  reviewer           User                       @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  decision           OnboardingReviewDecision
  comments           String?                    @db.VarChar(4000)
  // CORRECTION: [{ field, from, to }]; REQUEST_CHANGES: [{ field, message }].
  details            Json?
  applicationVersion Int
  reviewedAt         DateTime                   @default(now())

  @@index([applicationId, reviewedAt])
  @@map("salon_onboarding_reviews")
}

model SalonOnboardingStatusHistory {
  id             String                     @id @default(uuid())
  applicationId  String
  application    SalonOnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStatus OnboardingStatus?
  newStatus      OnboardingStatus
  actorId        String?
  actor          User?                      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  reason         String?                    @db.VarChar(1000)
  createdAt      DateTime                   @default(now())

  @@index([applicationId, createdAt])
  @@index([newStatus, createdAt])
  @@map("salon_onboarding_status_history")
}

// The secret lives only as PasswordResetToken.tokenHash (sha256); the raw token is never stored.
model SalonOnboardingInvitation {
  id                   String                     @id @default(uuid())
  applicationId        String
  application          SalonOnboardingApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ownerUserId          String
  ownerUser            User                       @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  passwordResetTokenId String?                    @unique
  passwordResetToken   PasswordResetToken?        @relation(fields: [passwordResetTokenId], references: [id], onDelete: SetNull)
  channel              String                     @default("EMAIL") @db.VarChar(16)
  status               OnboardingInvitationStatus @default(PENDING)
  attempts             Int                        @default(0)
  lastError            String?                    @db.VarChar(300)
  createdById          String
  sentAt               DateTime?
  expiresAt            DateTime
  acceptedAt           DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([applicationId, createdAt])
  @@index([ownerUserId, status])
  @@map("salon_onboarding_invitations")
}

model AccountDeletionRequest {
  id        String                       @id @default(uuid())
  userId    String                       @unique
  user      User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  status    AccountDeletionRequestStatus @default(REQUESTED)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([status, createdAt])
  @@map("account_deletion_requests")
}

model AppleAuthNonce {
  nonceHash String   @id @map("nonce_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamp(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)

  @@index([expiresAt])
  @@map("apple_auth_nonces")
}

// ============================================================================================
// FastQue Finance (admin portal): company expenses, who paid them, funding, reimbursements.
// Money is DECIMAL(14,2). Contributions are never revenue. Approval never marks an expense paid —
// only recorded payments do. Personal payments are not company cash. Finalised money rows are
// never deleted: they are voided with a reason, and every change is in finance_audit_events
// (append-only, enforced by a trigger). Actor user ids are stored without foreign keys so audit
// history survives user changes.
// ============================================================================================

enum FinanceExpenseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum FinanceContributorType {
  FOUNDER
  DIRECTOR
  INVESTOR
  CITY_PARTNER
  EMPLOYEE
  OTHER
}

enum FinanceFundingKind {
  CONTRIBUTION
  REPAYMENT
}

enum FinanceFundingClassification {
  SHARE_CAPITAL
  SHARE_APPLICATION_MONEY
  SHARE_PREMIUM
  FOUNDER_LOAN
  DIRECTOR_LOAN
  THIRD_PARTY_LOAN
  REIMBURSABLE_ADVANCE
  NON_REIMBURSABLE_CONTRIBUTION
  OTHER_FUNDING
  UNCLASSIFIED
}

enum FinanceAccountType {
  COMPANY_BANK
  COMPANY_CASH
  COMPANY_WALLET
}

enum FinancePaymentMethod {
  UPI
  BANK_TRANSFER
  CARD
  CASH
  CHEQUE
  OTHER
}

enum FinancePayerType {
  COMPANY_ACCOUNT
  PERSON
}

enum FinancePersonalTreatment {
  REIMBURSABLE
  FOUNDER_LOAN
  NON_REIMBURSABLE_CONTRIBUTION
}

enum FinanceReimbursementStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_REIMBURSED
  FULLY_REIMBURSED
  REJECTED
  CANCELLED
}

/// Main categories (parentId null) and their subcategories.
model FinanceCategory {
  id              String            @id @default(uuid()) @db.Uuid
  parentId        String?           @db.Uuid
  parent          FinanceCategory?  @relation("FinanceSubcategories", fields: [parentId], references: [id], onDelete: Restrict)
  subcategories   FinanceCategory[] @relation("FinanceSubcategories")
  name            String            @db.VarChar(80)
  normalizedName  String            @db.VarChar(80)
  department      String?           @db.VarChar(60)
  isSystem        Boolean           @default(false)
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdByUserId String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  expensesAsCategory    FinanceExpense[] @relation("FinanceExpenseCategory")
  expensesAsSubcategory FinanceExpense[] @relation("FinanceExpenseSubcategory")

  @@index([parentId, sortOrder])
  @@map("finance_categories")
}

/// A person or entity who funds FastQue or pays its expenses. Linked to a platform user when one
/// exists (one contributor per user); contributors need not be users.
model FinanceContributor {
  id        String                 @id @default(uuid()) @db.Uuid
  name      String                 @db.VarChar(120)
  type      FinanceContributorType
  userId    String?                @unique
  user      User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?                @db.VarChar(200)
  phone     String?                @db.VarChar(20)
  notes     String?                @db.VarChar(500)
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt DateTime               @updatedAt @db.Timestamptz(6)

  funding        FinanceFunding[]
  payments       FinanceExpensePayment[]
  reimbursements FinanceReimbursement[]

  @@map("finance_contributors")
}

/// A FastQue company account (bank / cash / wallet). Cash balance = opening balance + movements.
model FinanceAccount {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @db.VarChar(120)
  type               FinanceAccountType
  institution        String?            @db.VarChar(120)
  accountLast4       String?            @db.VarChar(4)
  openingBalance     Decimal            @default(0) @db.Decimal(14, 2)
  openingBalanceDate DateTime           @db.Date
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)

  payments FinanceExpensePayment[]
  funding  FinanceFunding[]
  payouts  FinanceReimbursementPayout[]

  @@map("finance_accounts")
}

model FinanceVendor {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(160)
  category      String?  @db.VarChar(80)
  contactPerson String?  @db.VarChar(120)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(200)
  address       String?  @db.VarChar(400)
  gstin         String?  @db.VarChar(15)
  paymentTerms  String?  @db.VarChar(120)
  /// Restricted (viewBankDetails).
  bankDetails   String?  @db.VarChar(400)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  expenses FinanceExpense[]

  @@map("finance_vendors")
}

model FinanceExpense {
  id                    String               @id @default(uuid()) @db.Uuid
  number                String               @unique @default(dbgenerated("('EXP-' || lpad(nextval('finance_expense_number_seq'::regclass)::text, 6, '0'))")) @db.VarChar(20)
  expenseDate           DateTime             @db.Date
  categoryId            String               @db.Uuid
  category              FinanceCategory      @relation("FinanceExpenseCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId         String?              @db.Uuid
  subcategory           FinanceCategory?     @relation("FinanceExpenseSubcategory", fields: [subcategoryId], references: [id], onDelete: Restrict)
  customSubcategory     String?              @db.VarChar(80)
  description           String               @db.VarChar(1000)
  /// Total incl. tax.
  amount                Decimal              @db.Decimal(14, 2)
  taxAmount             Decimal              @default(0) @db.Decimal(14, 2)
  currency              String               @default("INR") @db.VarChar(3)
  vendorId              String?              @db.Uuid
  vendor                FinanceVendor?       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  department            String?              @db.VarChar(60)
  city                  String?              @db.VarChar(60)
  project               String?              @db.VarChar(120)
  reimbursementRequired Boolean              @default(false)
  isRecurring           Boolean              @default(false)
  notes                 String?              @db.VarChar(1000)
  status                FinanceExpenseStatus @default(DRAFT)
  createdByUserId       String
  submittedAt           DateTime?            @db.Timestamptz(6)
  reviewedByUserId      String?
  reviewedAt            DateTime?            @db.Timestamptz(6)
  reviewNote            String?              @db.VarChar(500)
  cancelledAt           DateTime?            @db.Timestamptz(6)
  clientRequestId       String?              @unique @db.Uuid
  createdAt             DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(6)

  payments    FinanceExpensePayment[]
  attachments FinanceAttachment[]

  @@index([expenseDate])
  @@index([status, expenseDate])
  @@index([categoryId, expenseDate])
  @@index([createdByUserId, expenseDate])
  @@map("finance_expenses")
}

/// One payment toward an expense. Several rows split an expense between payers without
/// duplicating it; the sum of active rows never exceeds the expense amount.
model FinanceExpensePayment {
  id                String                    @id @default(uuid()) @db.Uuid
  expenseId         String                    @db.Uuid
  expense           FinanceExpense            @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  amount            Decimal                   @db.Decimal(14, 2)
  paidOn            DateTime                  @db.Date
  payerType         FinancePayerType
  accountId         String?                   @db.Uuid
  account           FinanceAccount?           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  contributorId     String?                   @db.Uuid
  contributor       FinanceContributor?       @relation(fields: [contributorId], references: [id], onDelete: Restrict)
  personalTreatment FinancePersonalTreatment?
  method            FinancePaymentMethod
  reference         String?                   @db.VarChar(120)
  voidedAt          DateTime?                 @db.Timestamptz(6)
  voidReason        String?                   @db.VarChar(500)
  voidedByUserId    String?
  createdByUserId   String
  clientRequestId   String?                   @unique @db.Uuid
  createdAt         DateTime                  @default(now()) @db.Timestamptz(6)

  reimbursements FinanceReimbursement[]

  @@index([expenseId])
  @@index([contributorId, paidOn])
  @@index([accountId, paidOn])
  @@map("finance_expense_payments")
}

/// Receipts/invoices, served only through authorised routes. New files live in private object storage
/// (storageKey); older rows, and environments without private storage, keep the bytes in `data`.
model FinanceAttachment {
  id               String                @id @default(uuid()) @db.Uuid
  expenseId        String?               @db.Uuid
  expense          FinanceExpense?       @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  reimbursementId  String?               @db.Uuid
  reimbursement    FinanceReimbursement? @relation(fields: [reimbursementId], references: [id], onDelete: Restrict)
  fileName         String                @db.VarChar(200)
  mimeType         String                @db.VarChar(80)
  sizeBytes        Int
  sha256           String                @db.VarChar(64)
  data             Bytes?
  storageKey       String?               @db.VarChar(200)
  uploadedByUserId String
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)

  @@unique([expenseId, sha256])
  @@unique([reimbursementId, sha256])
  @@map("finance_attachments")
}

/// Money received into a company account (CONTRIBUTION) or paid back to a contributor (REPAYMENT).
model FinanceFunding {
  id              String                       @id @default(uuid()) @db.Uuid
  number          String                       @unique @default(dbgenerated("('FND-' || lpad(nextval('finance_funding_number_seq'::regclass)::text, 6, '0'))")) @db.VarChar(20)
  contributorId   String                       @db.Uuid
  contributor     FinanceContributor           @relation(fields: [contributorId], references: [id], onDelete: Restrict)
  kind            FinanceFundingKind
  classification  FinanceFundingClassification
  date            DateTime                     @db.Date
  amount          Decimal                      @db.Decimal(14, 2)
  accountId       String                       @db.Uuid
  account         FinanceAccount               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  method          FinancePaymentMethod
  sourceAccount   String?                      @db.VarChar(120)
  reference       String?                      @db.VarChar(120)
  purpose         String?                      @db.VarChar(300)
  remarks         String?                      @db.VarChar(500)
  voidedAt        DateTime?                    @db.Timestamptz(6)
  voidReason      String?                      @db.VarChar(500)
  voidedByUserId  String?
  createdByUserId String
  clientRequestId String?                      @unique @db.Uuid
  createdAt       DateTime                     @default(now()) @db.Timestamptz(6)

  @@index([contributorId, date])
  @@index([date])
  @@map("finance_funding")
}

/// A claim to be paid back for one personal expense payment (one open claim per payment).
model FinanceReimbursement {
  id               String                     @id @default(uuid()) @db.Uuid
  number           String                     @unique @default(dbgenerated("('RMB-' || lpad(nextval('finance_reimbursement_number_seq'::regclass)::text, 6, '0'))")) @db.VarChar(20)
  expensePaymentId String                     @db.Uuid
  expensePayment   FinanceExpensePayment      @relation(fields: [expensePaymentId], references: [id], onDelete: Restrict)
  contributorId    String                     @db.Uuid
  contributor      FinanceContributor         @relation(fields: [contributorId], references: [id], onDelete: Restrict)
  amountRequested  Decimal                    @db.Decimal(14, 2)
  amountApproved   Decimal?                   @db.Decimal(14, 2)
  status           FinanceReimbursementStatus @default(SUBMITTED)
  note             String?                    @db.VarChar(500)
  reviewNote       String?                    @db.VarChar(500)
  reviewedByUserId String?
  reviewedAt       DateTime?                  @db.Timestamptz(6)
  createdByUserId  String
  clientRequestId  String?                    @unique @db.Uuid
  createdAt        DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @db.Timestamptz(6)

  payouts     FinanceReimbursementPayout[]
  attachments FinanceAttachment[]

  @@index([contributorId, status])
  @@index([expensePaymentId])
  @@map("finance_reimbursements")
}

/// Company money paid out against a reimbursement — settles the liability, not a new expense.
model FinanceReimbursementPayout {
  id              String               @id @default(uuid()) @db.Uuid
  reimbursementId String               @db.Uuid
  reimbursement   FinanceReimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Restrict)
  amount          Decimal              @db.Decimal(14, 2)
  paidOn          DateTime             @db.Date
  accountId       String               @db.Uuid
  account         FinanceAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  method          FinancePaymentMethod
  reference       String?              @db.VarChar(120)
  voidedAt        DateTime?            @db.Timestamptz(6)
  voidReason      String?              @db.VarChar(500)
  voidedByUserId  String?
  createdByUserId String
  clientRequestId String?              @unique @db.Uuid
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)

  @@index([reimbursementId])
  @@index([accountId, paidOn])
  @@map("finance_reimbursement_payouts")
}

/// Append-only history of every finance change (a trigger rejects UPDATE and DELETE).
model FinanceAuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @db.VarChar(40)
  entityId    String   @db.Uuid
  action      String   @db.VarChar(60)
  actorUserId String?
  changes     Json?    @db.JsonB
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt])
  @@map("finance_audit_events")
}

// =============================================================================================
// FastQue Work — student and gig workforce marketplace (docs/work-marketplace/ARCHITECTURE.md).
// Additive only: no existing table, column or enum changes. Every money column is integer paise.
// Balances are never stored — they are sums over the append-only double-entry ledger below.
// =============================================================================================

enum WorkOrgStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum WorkOrgMemberRole {
  OWNER
  MANAGER
  BILLING
}

enum WorkOrgType {
  INDIVIDUAL
  MSME
  STARTUP
  RETAIL
  RESTAURANT
  SALON
  EVENT_ORGANIZER
  MARKETING_AGENCY
  ENTERPRISE
  WORKFORCE_AGENCY
}

enum WorkerType {
  COLLEGE_STUDENT
  GRADUATE
  PART_TIME
  FREELANCER
  SKILLED_PROFESSIONAL
  FIELD_SALES
  SHIFT_WORKER
  DIGITAL_TASK
}

enum WorkJobStatus {
  DRAFT
  PENDING_VERIFICATION
  FUNDING_REQUIRED
  OPEN
  PARTIALLY_FILLED
  FILLED
  IN_PROGRESS
  COMPLETED
  CLOSED
  PAUSED
  CANCELLED
  EXPIRED
  REJECTED
}

enum WorkHiringMode {
  INSTANT_ACCEPT
  APPLY_AND_SELECT
}

enum WorkPayType {
  FIXED
  PER_TASK
  HOURLY
  DAILY
}

enum WorkLocationType {
  ON_SITE
  REMOTE
  HYBRID
}

enum WorkApplicationStatus {
  APPLIED
  OFFERED
  ACCEPTED
  REJECTED
  DECLINED
  WITHDRAWN
}

enum WorkAssignmentStatus {
  ACCEPTED
  CHECKED_IN
  SUBMITTED
  REWORK_REQUESTED
  DISPUTED
  PAYABLE
  PAID
  NO_SHOW_REVIEW
  WITHDRAWN
  CANCELLED
  CLOSED_UNPAID
}

enum WorkCheckInMethod {
  QR_CODE
  GPS
  EMPLOYER_CONFIRMED
  SELF_REPORTED
}

enum WorkFundingStatus {
  CREATED
  SUCCEEDED
  FAILED
}

enum WorkPayoutStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum WorkDisputeStatus {
  OPEN
  RESOLVED
  WITHDRAWN
}

enum WorkDisputeReason {
  UNFAIR_REJECTION
  PARTIAL_PAYMENT
  QUALITY_ISSUE
  NO_WORK_AVAILABLE
  NO_SHOW
  UNSAFE_CONDITIONS
  PAYMENT_PROBLEM
  OTHER
}

enum WorkParty {
  WORKER
  EMPLOYER
  PLATFORM
  SYSTEM
}

// Admin-managed category taxonomy (seeded by the migration, editable without code changes).
model WorkCategory {
  id          String    @id @default(uuid())
  slug        String    @unique @db.VarChar(60)
  name        String    @db.VarChar(80)
  description String?   @db.VarChar(300)
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  jobs        WorkJob[]

  @@map("work_categories")
}

// An employer organization, separate from the user accounts that act for it.
model WorkOrganization {
  id                String            @id @default(uuid())
  legalName         String            @db.VarChar(160)
  displayName       String            @db.VarChar(80)
  orgType           WorkOrgType
  gstin             String?           @db.VarChar(15)
  registeredAddress String            @db.VarChar(300)
  city              String            @db.VarChar(80)
  contactName       String            @db.VarChar(120)
  contactPhone      String            @db.VarChar(16)
  contactEmail      String            @db.VarChar(160)
  status            WorkOrgStatus     @default(DRAFT)
  rejectionReason   String?           @db.VarChar(1000)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  createdById       String
  createdBy         User              @relation("WorkOrgCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  members           WorkOrgMember[]
  jobs              WorkJob[]

  @@index([status, submittedAt])
  @@map("work_organizations")
}

model WorkOrgMember {
  id        String            @id @default(uuid())
  orgId     String
  org       WorkOrganization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("WorkOrgMembership", fields: [userId], references: [id], onDelete: Restrict)
  role      WorkOrgMemberRole
  createdAt DateTime          @default(now())

  @@unique([orgId, userId])
  @@index([userId])
  @@map("work_org_members")
}

model WorkerProfile {
  userId              String     @id
  user                User       @relation("WorkerProfile", fields: [userId], references: [id], onDelete: Restrict)
  fullName            String     @db.VarChar(120)
  workerType          WorkerType
  dateOfBirth         DateTime   @db.Date
  city                String     @db.VarChar(80)
  locality            String?    @db.VarChar(80)
  workRadiusKm        Int        @default(10)
  languages           String[]
  skills              String[]
  preferredCategories String[]
  collegeName         String?    @db.VarChar(160)
  bio                 String?    @db.VarChar(600)
  payoutUpiVpa        String?    @db.VarChar(100)
  // Bank payout details for manual NEFT payouts. The account number is AES-256-GCM encrypted
  // (CryptoService); only its last 4 digits are stored in clear, for masked display.
  payoutBankAccountEncrypted String? @db.Text
  payoutBankAccountLast4     String? @db.VarChar(4)
  payoutBankIfsc             String? @db.VarChar(11)
  payoutBankAccountName      String? @db.VarChar(120)
  // 1 = phone verified (granted at profile creation only when User.phoneVerifiedAt is set),
  // 2 = basic eligibility verified by a platform reviewer. 3/4 are reserved.
  verificationLevel   Int        @default(0)
  verifiedById        String?
  verifiedAt          DateTime?
  suspendedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([city])
  @@map("worker_profiles")
}

model WorkJob {
  id                   String           @id @default(uuid())
  orgId                String
  org                  WorkOrganization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  categoryId           String
  category             WorkCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title                String           @db.VarChar(120)
  description          String           @db.VarChar(4000)
  locationType         WorkLocationType
  addressLine          String?          @db.VarChar(300)
  city                 String           @db.VarChar(80)
  locality             String?          @db.VarChar(80)
  positions            Int
  // Slot-holding assignments. Only ever changed inside the row-locked accept/release transaction;
  // a CHECK constraint keeps it within 0..positions.
  filledCount          Int              @default(0)
  startsAt             DateTime
  endsAt               DateTime
  applicationDeadline  DateTime?
  payType              WorkPayType
  payPerWorkerPaise    Int
  bonusDescription     String?          @db.VarChar(300)
  feeBps               Int
  minAge               Int              @default(18)
  minVerificationLevel Int              @default(1)
  requiredSkills       String[]
  languages            String[]
  hiringMode           WorkHiringMode
  requiresCheckIn      Boolean          @default(true)
  checkInCode          String           @db.VarChar(12)
  checklist            Json
  completionCriteria   String           @db.VarChar(1000)
  cancellationTerms    Json
  reviewWindowHours    Int              @default(72)
  status               WorkJobStatus    @default(DRAFT)
  screeningFlags       Json?
  moderationNote       String?          @db.VarChar(1000)
  // Bumped on every edit; the publish/fund request must quote the version the employer approved.
  version              Int              @default(1)
  publishedAt          DateTime?
  closedAt             DateTime?
  createdById          String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  applications         WorkApplication[]
  assignments          WorkAssignment[]
  fundings             WorkFunding[]

  @@index([status, startsAt])
  @@index([orgId, createdAt])
  @@index([city, status])
  @@map("work_jobs")
}

model WorkApplication {
  id          String                @id @default(uuid())
  jobId       String
  job         WorkJob               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  workerId    String
  worker      User                  @relation("WorkApplicationWorker", fields: [workerId], references: [id], onDelete: Restrict)
  status      WorkApplicationStatus @default(APPLIED)
  note        String?               @db.VarChar(600)
  decidedAt   DateTime?
  decidedById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([jobId, workerId])
  @@index([workerId, createdAt])
  @@map("work_applications")
}

model WorkAssignment {
  id                 String               @id @default(uuid())
  jobId              String
  job                WorkJob              @relation(fields: [jobId], references: [id], onDelete: Restrict)
  workerId           String
  worker             User                 @relation("WorkAssignmentWorker", fields: [workerId], references: [id], onDelete: Restrict)
  applicationId      String?              @unique
  // 1..positions. Partial unique indexes (migration.sql) stop two live assignments sharing a slot
  // or one worker holding two live slots on the same job.
  slotNumber         Int
  status             WorkAssignmentStatus @default(ACCEPTED)
  agreedPayPaise     Int
  // The pay, checklist, completion and cancellation terms exactly as shown when the worker accepted.
  termsSnapshot      Json
  checkedInAt        DateTime?
  checkInMethod      WorkCheckInMethod?
  checkInLatitude    Float?
  checkInLongitude   Float?
  submittedAt        DateTime?
  reviewDueAt        DateTime?
  reviewedAt         DateTime?
  reviewNote         String?              @db.VarChar(1000)
  approvedAmountPaise Int?
  lateCancellation   Boolean              @default(false)
  cancelledAt        DateTime?
  cancelReason       String?              @db.VarChar(500)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  responses          WorkTaskResponse[]
  payouts            WorkPayout[]
  disputes           WorkDispute[]

  @@index([workerId, status])
  @@index([jobId, status])
  @@index([status, reviewDueAt])
  @@map("work_assignments")
}

model WorkTaskResponse {
  id             String            @id @default(uuid())
  assignmentId   String
  assignment     WorkAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  itemId         String            @db.VarChar(40)
  confirmed      Boolean           @default(false)
  text           String?           @db.VarChar(2000)
  normalizedText String?           @db.VarChar(2000)
  evidenceFileId String?           @unique
  evidenceFile   WorkEvidenceFile? @relation(fields: [evidenceFileId], references: [id], onDelete: Restrict)
  duplicateFlag  Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([assignmentId, itemId])
  @@map("work_task_responses")
}

// Task evidence photos are private and served only through an authorized endpoint. New files live in
// private object storage (storageKey); older rows, and environments without private storage, keep
// the bytes in `content`.
model WorkEvidenceFile {
  id           String            @id @default(uuid())
  assignmentId String
  uploadedById String
  mimeType     String            @db.VarChar(40)
  sizeBytes    Int
  sha256       String            @db.VarChar(64)
  content      Bytes?
  storageKey   String?           @db.VarChar(200)
  createdAt    DateTime          @default(now())
  response     WorkTaskResponse?

  @@index([sha256])
  @@index([assignmentId])
  @@map("work_evidence_files")
}

model WorkFunding {
  id              String            @id @default(uuid())
  jobId           String
  job             WorkJob           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  jobVersion      Int
  amountPaise     Int
  provider        String            @db.VarChar(40)
  providerOrderId String            @unique @db.VarChar(120)
  status          WorkFundingStatus @default(CREATED)
  idempotencyKey  String            @unique @db.VarChar(120)
  confirmedAt     DateTime?
  // Manual bank transfer: the bank UTR a platform admin recorded, and who recorded it.
  manualUtr       String?           @unique @db.VarChar(40)
  manualConfirmedById String?
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([jobId])
  @@map("work_fundings")
}

model WorkPayout {
  id               String           @id @default(uuid())
  assignmentId     String
  assignment       WorkAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  workerId         String
  worker           User             @relation("WorkPayoutWorker", fields: [workerId], references: [id], onDelete: Restrict)
  amountPaise      Int
  attempt          Int
  provider         String           @db.VarChar(40)
  providerPayoutId String?          @unique @db.VarChar(120)
  status           WorkPayoutStatus @default(PENDING)
  failureReason    String?          @db.VarChar(300)
  // Sent to the provider so a retried HTTP call can never create a second transfer.
  idempotencyKey   String           @unique @db.VarChar(120)
  initiatedAt      DateTime?
  settledAt        DateTime?
  // Manual NEFT payout: the bank UTR a platform admin recorded, and who recorded it.
  manualUtr        String?          @unique @db.VarChar(40)
  manualConfirmedById String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([assignmentId, attempt])
  @@index([status, createdAt])
  @@map("work_payouts")
}

model WorkDispute {
  id             String            @id @default(uuid())
  assignmentId   String
  assignment     WorkAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  openedById     String
  openedBy       User              @relation("WorkDisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  openedByParty  WorkParty
  reasonCode     WorkDisputeReason
  description    String            @db.VarChar(2000)
  // The assignment state the dispute was opened from, restored or settled on resolution.
  fromStatus     WorkAssignmentStatus
  status         WorkDisputeStatus @default(OPEN)
  awardPaise     Int?
  resolutionNote String?           @db.VarChar(2000)
  resolvedById   String?
  slaDueAt       DateTime
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())

  @@index([status, slaDueAt])
  @@index([assignmentId])
  @@map("work_disputes")
}

// Provider webhook deliveries, keyed by the provider's own event id so a replay is a no-op.
model WorkWebhookEvent {
  id              String    @id @default(uuid())
  provider        String    @db.VarChar(40)
  providerEventId String    @db.VarChar(120)
  eventType       String    @db.VarChar(60)
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@map("work_webhook_events")
}

// Double-entry ledger. A journal's entries always sum to zero (deferred constraint trigger), and
// neither table can be updated or deleted (triggers in migration.sql). Positive = debit.
model WorkLedgerJournal {
  id             String            @id @default(uuid())
  kind           String            @db.VarChar(40)
  idempotencyKey String            @unique @db.VarChar(160)
  memo           String?           @db.VarChar(300)
  jobId          String?
  assignmentId   String?
  createdAt      DateTime          @default(now())
  entries        WorkLedgerEntry[]

  @@index([jobId])
  @@index([assignmentId])
  @@map("work_ledger_journals")
}

model WorkLedgerEntry {
  id          String            @id @default(uuid())
  journalId   String
  journal     WorkLedgerJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)
  accountCode String            @db.VarChar(120)
  amountPaise Int
  createdAt   DateTime          @default(now())

  @@index([accountCode])
  @@index([journalId])
  @@map("work_ledger_entries")
}

// Append-only history of every state change and sensitive action in the marketplace.
model WorkAuditEvent {
  id          String    @id @default(uuid())
  entityType  String    @db.VarChar(40)
  entityId    String
  action      String    @db.VarChar(60)
  fromStatus  String?   @db.VarChar(40)
  toStatus    String?   @db.VarChar(40)
  actorUserId String?
  actorParty  WorkParty
  orgId       String?
  jobId       String?
  note        String?   @db.VarChar(1000)
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([jobId, createdAt])
  @@index([orgId, createdAt])
  @@map("work_audit_events")
}

// ============================ FastQue Home (home beauty services) ============================
// Off unless FASTQUE_HOME_ENABLED=true. See docs/home/. Additive only: existing tables are not
// changed (relation fields add no columns). Money is in paise; times are timestamptz (UTC).

enum HomeProviderKind {
  SALON_MANAGED
  INDEPENDENT_PROFESSIONAL
}

enum HomeProviderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
}

enum HomeServiceStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum HomeAreaKind {
  RADIUS
  PINCODE
  LOCALITY
  CITY
  SOCIETY
}

enum HomeTravelMode {
  WALK
  BICYCLE
  TWO_WHEELER
  CAR
  PUBLIC_TRANSPORT
}

enum ProfessionalCommitmentKind {
  HOME_HOLD
  HOME_BOOKING
  BREAK
  TIME_OFF
}

enum HomeBookingMode {
  INSTANT
  SCHEDULED
}

enum HomePreference {
  SPECIFIC_PROFESSIONAL
  SPECIFIC_PROVIDER
  FASTEST
}

enum HomeBookingStatus {
  DRAFT
  REQUESTED
  AWAITING_ASSIGNMENT
  INVITED
  ACCEPTED
  CONFIRMED
  PREPARING
  ON_THE_WAY
  ARRIVED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  CLOSED
  NO_PROFESSIONAL
  EXPIRED
  RESCHEDULE_REQUESTED
  REPLACEMENT_REQUESTED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_PROFESSIONAL
  CANCELLED_BY_SALON
  CANCELLED_BY_PLATFORM
  CUSTOMER_NO_SHOW
  PROFESSIONAL_NO_SHOW
  ADDRESS_ISSUE
  INTERRUPTED
}

enum HomePaymentStatus {
  NOT_DUE
  PENDING
  PARTIAL
  CONFIRMED
  DISPUTED
}

enum HomePaymentMethod {
  CASH
  DIRECT_UPI
  OTHER_OFFLINE
}

enum HomeComplaintStatus {
  NONE
  RAISED
  UNDER_REVIEW
  RESOLVED
}

enum HomeRefundStatus {
  NONE
  APPROVED
  RECORDED
}

enum HomeInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum HomeAssignmentStatus {
  ACTIVE
  RELEASED
  COMPLETED
}

enum HomeCodePurpose {
  START
  COMPLETE
}

enum HomeVerificationScope {
  MOBILE
  IDENTITY
  EXPERIENCE
  TRAINING_CERTIFICATE
  REFERENCES
  SKILL_ASSESSMENT
  EQUIPMENT
  HYGIENE_TRAINING
  SERVICE_QUALIFICATION
  BACKGROUND_CHECK
}

enum HomeVerificationStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  SUSPENDED
}

enum HomeAdjustmentStatus {
  PENDING
  APPROVED
  DECLINED
}

model HomeProvider {
  id                  String             @id @default(uuid())
  kind                HomeProviderKind
  status              HomeProviderStatus @default(DRAFT)
  // Exactly one of salonId / userId is set (CHECK constraint in the migration).
  salonId             String?            @unique
  salon               Salon?             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  userId              String?            @unique
  user                User?              @relation("HomeProviderUser", fields: [userId], references: [id], onDelete: Restrict)
  displayName         String             @db.VarChar(120)
  bio                 String?            @db.VarChar(1000)
  category            String?            @db.VarChar(60)
  city                String             @db.VarChar(80)
  locality            String?            @db.VarChar(120)
  // Where travel normally starts. Never returned by a public API.
  baseLat             Float?
  baseLng             Float?
  languages           String[]
  equipment           String[]
  productsCarried     String[]
  travelMode          HomeTravelMode     @default(TWO_WHEELER)
  maxTravelMinutes    Int                @default(60)
  instantEnabled      Boolean            @default(false)
  scheduledEnabled    Boolean            @default(true)
  paused              Boolean            @default(false)
  autoDispatch        Boolean            @default(true)
  minOrderPaise       Int                @default(0)
  travelFeePaise      Int                @default(0)
  weekendSurchargePct Int                @default(0)
  peakSurchargePct    Int                @default(0)
  peakStart           String?            @db.VarChar(5)
  peakEnd             String?            @db.VarChar(5)
  groupDiscountPct    Int                @default(0)
  groupDiscountMin    Int                @default(3)
  upiVpa              String?            @db.VarChar(100)
  invoiceIssuer       String?            @db.VarChar(160)
  // Salon capacity protection (SALON_MANAGED only).
  minStaffInSalon     Int                @default(1)
  maxHomeStaff        Int                @default(1)
  queueWaitingLimit   Int                @default(3)
  manualApproval      Boolean            @default(false)
  blockWeekends       Boolean            @default(false)
  blockedStart        String?            @db.VarChar(5)
  blockedEnd          String?            @db.VarChar(5)
  // Emergency contact (independents): private, never public.
  emergencyName       String?            @db.VarChar(120)
  emergencyPhone      String?            @db.VarChar(20)
  compensation        Json?
  termsVersion        String?            @db.VarChar(20)
  termsAcceptedAt     DateTime?          @db.Timestamptz(6)
  publicConsentAt     DateTime?          @db.Timestamptz(6)
  adultDeclaredAt     DateTime?          @db.Timestamptz(6)
  assistedByUserId    String?
  submittedAt         DateTime?          @db.Timestamptz(6)
  reviewedByUserId    String?
  reviewedAt          DateTime?          @db.Timestamptz(6)
  reviewNote          String?            @db.VarChar(1000)
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(6)

  professionals HomeProfessional[]
  offerings     HomeOffering[]
  areas         HomeServiceArea[]
  bookings      HomeBooking[]
  promotions    HomePromotion[]
  packages      HomePackage[]
  fees          HomePlatformFee[]
  settlements   HomeSettlement[]
  feeRules      HomeFeeRule[]
  campaigns     HomeCampaign[]

  @@index([status, city])
  @@index([kind, status])
  @@map("home_providers")
}

model HomeProfessional {
  id              String       @id @default(uuid())
  providerId      String
  provider        HomeProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  userId          String
  user            User         @relation("HomeProfessionalUser", fields: [userId], references: [id], onDelete: Restrict)
  salonStaffId    String?      @unique
  salonStaff      SalonStaff?  @relation(fields: [salonStaffId], references: [id], onDelete: Restrict)
  displayName     String       @db.VarChar(120)
  photoUrl        String?      @db.VarChar(500)
  bio             String?      @db.VarChar(1000)
  yearsExperience Int?
  skills          String[]
  languages       String[]
  portfolioUrls   String[]
  // The professional's own consent to appear and be booked in this channel. No consent = never listed.
  consentAt       DateTime?    @db.Timestamptz(6)
  active          Boolean      @default(true)
  suspendedAt     DateTime?    @db.Timestamptz(6)
  dedicated       Boolean      @default(false)
  isOnline        Boolean      @default(false)
  onlineSince     DateTime?    @db.Timestamptz(6)
  maxPerDay       Int          @default(6)
  priceUpliftPct  Int          @default(0)
  trustedContact  String?      @db.VarChar(20)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  services      HomeProfessionalService[]
  schedules     HomeSchedule[]
  invitations   HomeInvitation[]
  assignments   HomeAssignment[]
  verifications HomeVerification[]
  favorites     HomeFavorite[]
  reviews       HomeReview[]
  productUses   HomeProductUse[]
  recurring     HomeRecurringPlan[]

  @@unique([providerId, userId])
  @@index([userId])
  @@index([active, isOnline])
  @@map("home_professionals")
}

model HomeCategory {
  id                    String           @id @default(uuid())
  code                  String           @unique @db.VarChar(60)
  groupCode             String           @db.VarChar(30)
  name                  String           @db.VarChar(120)
  nameHi                String           @db.VarChar(120)
  sortOrder             Int              @default(0)
  active                Boolean          @default(true)
  // Requires a VERIFIED SERVICE_QUALIFICATION before a professional may be booked for it.
  requiresQualification Boolean          @default(false)
  services              HomeServiceDef[]

  @@map("home_categories")
}

model HomeServiceDef {
  id                  String            @id @default(uuid())
  categoryId          String
  category            HomeCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  code                String            @unique @db.VarChar(60)
  name                String            @db.VarChar(120)
  nameHi              String            @db.VarChar(120)
  description         String?           @db.VarChar(1000)
  imageUrl            String?           @db.VarChar(500)
  synonyms            String[]
  durationMinutes     Int
  prepMinutes         Int               @default(5)
  cleanupMinutes      Int               @default(5)
  requiredSkills      String[]
  requiredEquipment   String[]
  productNotes        String?           @db.VarChar(500)
  customerPreparation String?           @db.VarChar(500)
  eligibility         String?           @db.VarChar(500)
  safetyInstructions  String?           @db.VarChar(1000)
  addOnCodes          String[]
  cancellationNote    String?           @db.VarChar(500)
  pricingModel        String            @default("FIXED") @db.VarChar(20)
  customerProducts    Boolean           @default(false)
  forChildren         Boolean           @default(false)
  minPricePaise       Int?
  maxPricePaise       Int?
  status              HomeServiceStatus @default(ACTIVE)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)
  offerings           HomeOffering[]

  @@index([categoryId, status])
  @@map("home_service_defs")
}

model HomeOffering {
  id              String         @id @default(uuid())
  providerId      String
  provider        HomeProvider   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  serviceDefId    String
  serviceDef      HomeServiceDef @relation(fields: [serviceDefId], references: [id], onDelete: Restrict)
  // The in-salon service it was created from, for reference. Home code never writes that service.
  salonServiceId  String?
  title           String?        @db.VarChar(120)
  pricePaise      Int
  productPaise    Int            @default(0)
  disposablePaise Int            @default(0)
  equipmentPaise  Int            @default(0)
  durationMinutes Int
  variants        Json?
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  professionals HomeProfessionalService[]
  items         HomeBookingItem[]
  productRules  HomeOfferingProduct[]

  @@unique([providerId, serviceDefId])
  @@index([serviceDefId, active])
  @@map("home_offerings")
}

model HomeOfferingProduct {
  id         String           @id @default(uuid())
  offeringId String
  offering   HomeOffering     @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  productId  String
  product    InventoryProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Decimal          @db.Decimal(12, 3)

  @@unique([offeringId, productId])
  @@map("home_offering_products")
}

model HomeProfessionalService {
  professionalId String
  professional   HomeProfessional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  offeringId     String
  offering       HomeOffering     @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@id([professionalId, offeringId])
  @@index([offeringId])
  @@map("home_professional_services")
}

model HomeServiceArea {
  id             String       @id @default(uuid())
  providerId     String
  provider       HomeProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  kind           HomeAreaKind
  value          String       @db.VarChar(120)
  radiusKm       Float?
  excluded       Boolean      @default(false)
  surchargePaise Int          @default(0)
  minOrderPaise  Int          @default(0)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([providerId, kind, value])
  @@index([kind, value])
  @@map("home_service_areas")
}

model HomeSchedule {
  id             String           @id @default(uuid())
  professionalId String
  professional   HomeProfessional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  startTime      String           @db.VarChar(5)
  endTime        String           @db.VarChar(5)

  @@unique([professionalId, dayOfWeek])
  @@map("home_schedules")
}

// The one shared reservation ledger per PERSON (whichever provider they work for). The migration adds
// an exclusion constraint: two unreleased rows of one person can never overlap.
model ProfessionalCommitment {
  id           String                     @id @default(uuid())
  userId       String
  user         User                       @relation("ProfessionalCommitments", fields: [userId], references: [id], onDelete: Restrict)
  kind         ProfessionalCommitmentKind
  startAt      DateTime                   @db.Timestamptz(6)
  endAt        DateTime                   @db.Timestamptz(6)
  // The visit itself (inside the blocked window) and where it happens, for travel checks.
  serviceStart DateTime?                  @db.Timestamptz(6)
  serviceEnd   DateTime?                  @db.Timestamptz(6)
  lat          Float?
  lng          Float?
  postalCode   String?                    @db.VarChar(10)
  bookingId    String?
  booking      HomeBooking?               @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  note         String?                    @db.VarChar(200)
  expiresAt    DateTime?                  @db.Timestamptz(6)

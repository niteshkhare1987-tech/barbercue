model HomeBooking {
  id                      String              @id @default(uuid())
  code                    String              @unique @db.VarChar(16)
  customerId              String?
  customer                User?               @relation("HomeBookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  guestName               String?             @db.VarChar(120)
  guestPhone              String?             @db.VarChar(20)
  guestPhoneVerifiedAt    DateTime?           @db.Timestamptz(6)

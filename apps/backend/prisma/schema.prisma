  status                  HomeBookingStatus
  paymentStatus           HomePaymentStatus   @default(NOT_DUE)
  complaintStatus         HomeComplaintStatus @default(NONE)
  refundStatus            HomeRefundStatus    @default(NONE)
  paymentMethod           HomePaymentMethod
  serviceStart            DateTime            @db.Timestamptz(6)
  serviceEnd              DateTime            @db.Timestamptz(6)
  etaFrom                 DateTime?           @db.Timestamptz(6)
  etaTo                   DateTime?           @db.Timestamptz(6)
  etaConfidence           String?             @db.VarChar(10)
  etaBasis                Json?
  totalPaise              Int
  priceSnapshot           Json
  termsSnapshot           Json
  notes                   String?             @db.VarChar(500)
  productPreference       String              @default("PROFESSIONAL") @db.VarChar(20)
  forChild                Boolean             @default(false)
  guardianConfirmed       Boolean             @default(false)
  delayMinutes            Int                 @default(0)
  travelStartedAt         DateTime?           @db.Timestamptz(6)
  arrivedAt               DateTime?           @db.Timestamptz(6)
  startedAt               DateTime?           @db.Timestamptz(6)
  completedAt             DateTime?           @db.Timestamptz(6)
  cancelledAt             DateTime?           @db.Timestamptz(6)
  cancelReason            String?             @db.VarChar(500)
  rescheduleTo            DateTime?           @db.Timestamptz(6)
  replacementProposedId   String?
  dispatchDeadline        DateTime?           @db.Timestamptz(6)
  idempotencyKey          String              @unique @db.VarChar(80)
  recurringPlanId         String?
  recurringPlan           HomeRecurringPlan?  @relation(fields: [recurringPlanId], references: [id], onDelete: SetNull)
  campaignId              String?
  campaign                HomeCampaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  promotionId             String?
  shareHash               String?             @unique @db.VarChar(64)
  createdAt               DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(6)

  items       HomeBookingItem[]
  events      HomeBookingEvent[]
  invitations HomeInvitation[]
  assignments HomeAssignment[]
  commitments ProfessionalCommitment[]
  codes       HomeServiceCode[]
  tracking    HomeTrackingSession[]
  payments    HomePaymentRecord[]
  earnings    HomeEarning[]
  adjustments HomePriceAdjustment[]
  hygiene     HomeHygieneRecord[]
  review      HomeReview?
  feedback    HomeProfessionalFeedback?
  incidents   HomeIncident[]
  tickets     HomeTicket[]
  productUses HomeProductUse[]
  fees        HomePlatformFee[]
  refunds     HomeRefundRecord[]

  @@index([customerId, createdAt])
  @@index([providerId, status, serviceStart])
  @@index([status, serviceStart])
  @@index([status, dispatchDeadline])
  @@index([groupKey])
  @@map("home_bookings")
}

model HomeBookingItem {

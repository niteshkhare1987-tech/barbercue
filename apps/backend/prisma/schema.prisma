enum NotificationChannel {
  SMS
  PUSH
  EMAIL
  // Phase 11 (Notification Center) — the only channel with no external provider to configure;
  // every in-app notification is this channel, always immediately SENT (there is nothing to fail
  // to deliver). SMS/PUSH/EMAIL stay reserved for when a real provider is actually wired
  // (Phase 13's communication-preferences architecture) — this mission does not add one.
  IN_APP
  // Phase 13 — architecture-only, same as SMS/PUSH/EMAIL: manual/deep-link WhatsApp sharing
  // already exists (Phase 3's share flow), but proactive WhatsApp Business API delivery is
  // explicitly out of scope for this mission (no provider configured).
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// Phase 13 (Communication Preferences) — every NotificationType (packages/shared) maps to exactly
// one of these; see NotificationsService's TYPE_CATEGORY. OPERATIONAL categories default enabled
// (a customer expects to hear about their own bookings); PROMOTIONAL defaults enabled too today
// only because nothing currently produces that category — Phase 20+'s offers work should default
// it to opt-in rather than assuming this default carries over.
enum NotificationCategory {
  BOOKING_UPDATES
  QUEUE_UPDATES
  REMINDERS
  PROMOTIONAL
}

// One row per (user, category, channel) the user has explicitly changed from its default. No row
// = default (enabled), same "absence means default" convention as StaffWorkingHours (Phase 7).
model NotificationPreference {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime             @updatedAt

  @@unique([userId, category, channel])
  @@map("notification_preferences")
}

// ---------- Identity & access ----------

model User {
  id                String     @id @default(uuid())
  phone             String?    @unique
  email             String?    @unique
  passwordHash      String?
  phoneVerifiedAt   DateTime?
  emailVerifiedAt   DateTime?
  status            UserStatus @default(ACTIVE)
  twoFactorEnabled  Boolean    @default(false)
  totpSecret        String?
  // Phase 14 (Localization & Voice Operations) — drives which packages/shared/src/i18n
  // VoiceAnnouncements dictionary realtime alert handlers speak from, plus the language switcher's
  // initial state. Defaults to EN, so every existing/new user behaves exactly as before this field
  // existed until they explicitly change it.
  preferredLanguage Language   @default(EN)
  // A customer deletion is an irreversible anonymization rather than a physical User-row delete:
  // necessary booking/accounting/security records may retain FK integrity in de-identified form,
  // while direct identity, authentication data and customer-authored reviews are removed.
  // Non-null only after the one-way deletion transaction.
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  crmAnnouncements              CrmAnnouncement[] @relation("CrmAnnouncementCreator")
  roles                         UserRole[]
  authIdentities                AuthIdentity[]
  accountDeletionRequest AccountDeletionRequest?
  refreshTokens                 RefreshToken[]
  passwordResetTokens           PasswordResetToken[]
  ownedSalons                   Salon[]                  @relation("SalonOwner")
  staffMemberships              SalonStaff[]
  bookings                      Booking[]                @relation("BookingCustomer")
  offerRedemptions              OfferRedemption[]
  cancelledBookings             Booking[]                @relation("BookingCancelledBy")
  queueEntries                  QueueEntry[]
  reviews                       Review[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  ledgerEntries                 CustomerLedgerEntry[]
  auditLogs                     AuditLog[]
  favoriteSalons                CustomerFavorite[]
  recentSalonViews              CustomerRecentSalonView[]
  inventoryMovements            InventoryMovement[]
  globalProductsCreated  GlobalProduct[] @relation("GlobalProductCreator")
  globalProductsReviewed GlobalProduct[] @relation("GlobalProductReviewer")
  inventoryUploadJobs    InventoryUploadJob[]
  catalogChangeRequests  CatalogChangeRequest[] @relation("CatalogChangeRequester")
  catalogChangeResolved  CatalogChangeRequest[] @relation("CatalogChangeResolver")
  shopListingsReviewed   ShopListing[]          @relation("ShopListingReviewer")
  shopOrders             ShopOrder[]            @relation("ShopOrderCustomer")
  shopOrderEvents        ShopOrderEvent[]
  shopWishlist           ShopWishlistItem[]
  serviceUsagesRecorded  ServiceUsage[]  @relation("ServiceUsageRecordedBy")
  serviceUsagesReversed  ServiceUsage[]  @relation("ServiceUsageReversedBy")
  otpRequests                   OtpRequest[]             @relation("OtpRequestSubject")
  premiumSubscriptions          CustomerSubscription[]
  // Phase 18 (Shop / Barber Verification Foundation) — an owner submitting evidence, and a
  // PLATFORM_ADMIN reviewing it, are deliberately separate relations (never the same person in
  // practice, and keeping them distinct makes that impossible to blur by accident).
  submittedVerifications        VerificationRequest[]    @relation("VerificationSubmitter")
  reviewedVerifications         VerificationRequest[]    @relation("VerificationReviewer")
  submittedLocationProposals    SalonLocationProposal[]  @relation("SalonLocationSubmitter")
  reviewedLocationProposals     SalonLocationProposal[]  @relation("SalonLocationReviewer")
  pushDevices                   PushDevice[]
  creditAccount                 CustomerCreditAccount?
  manualChairOccupanciesStarted ManualChairOccupancy[]   @relation("ManualChairOccupancyStartedBy")
  manualChairOccupanciesEnded   ManualChairOccupancy[]   @relation("ManualChairOccupancyEndedBy")
  employeeProfile               EmployeeProfile?
  createdDemoWorkspaces         OwnerDemoWorkspace[]     @relation("OwnerDemoWorkspaceCreator")
  onboardingCreated             SalonOnboardingApplication[] @relation("OnboardingCreatedBy")
  onboardingReviewing           SalonOnboardingApplication[] @relation("OnboardingReviewer")
  onboardingApproved            SalonOnboardingApplication[] @relation("OnboardingApprovedBy")
  onboardingReviews             SalonOnboardingReview[]
  onboardingStatusChanges       SalonOnboardingStatusHistory[]
  onboardingMediaUploads        SalonOnboardingMedia[]
  onboardingInvitations         SalonOnboardingInvitation[]
  crmLeadImports                CrmLeadImportJob[]      @relation("CrmLeadImportUploader")
  crmLeadActivities             CrmLeadActivity[]       @relation("CrmLeadActivityActor")
  crmTasksCreated               CrmTask[]               @relation("CrmTaskCreator")
  supportTicketsCreated         SupportTicket[]         @relation("SupportTicketCreator")
  supportTicketsAssigned        SupportTicket[]         @relation("SupportTicketAssignee")
  supportTicketComments         SupportTicketComment[]  @relation("SupportTicketCommentAuthor")
  financeContributor            FinanceContributor?

  // FastQue Work marketplace
  workOrgsCreated               WorkOrganization[]       @relation("WorkOrgCreator")
  workOrgMemberships            WorkOrgMember[]          @relation("WorkOrgMembership")
  workerProfile                 WorkerProfile?           @relation("WorkerProfile")
  workApplications              WorkApplication[]        @relation("WorkApplicationWorker")
  workAssignments               WorkAssignment[]         @relation("WorkAssignmentWorker")
  workPayouts                   WorkPayout[]             @relation("WorkPayoutWorker")
  workDisputesOpened            WorkDispute[]            @relation("WorkDisputeOpener")

  homeProvider                  HomeProvider?            @relation("HomeProviderUser")
  homeProfessionals             HomeProfessional[]       @relation("HomeProfessionalUser")
  homeAddresses                 HomeAddress[]            @relation("HomeAddresses")
  homeBookings                  HomeBooking[]            @relation("HomeBookingCustomer")
  professionalCommitments       ProfessionalCommitment[] @relation("ProfessionalCommitments")

  @@map("users")
}

// salonId is nullable and null is the documented convention for a GLOBAL role — PLATFORM_ADMIN is
// always global (see SalonAccessService's own doc comment); SALON_OWNER/SALON_STAFF always carry a
// real salonId. A raw DB CHECK constraint (added outside this file — Prisma's schema DSL has no
// multi-column CHECK support — see migration 20260906020000's migration.sql) enforces
// `role != 'PLATFORM_ADMIN' OR "salonId" IS NULL` as defense in depth: a salon-scoped PLATFORM_ADMIN
// row cannot be persisted at all, regardless of what application code does. No other role is
// constrained by it.
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role
  salonId   String?
  salon     Salon?   @relation(fields: [salonId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, role, salonId])
  @@map("user_roles")
}

// One row per (provider, external account) a User has linked — additive to, never a replacement
// for, phone/password auth on User itself. A customer can hold a phone-OTP identity AND a Google
// identity on the same User row; sign-in through either lands on the same account.
model AuthIdentity {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  provider    AuthProvider
  // The provider's own stable subject identifier (Google's `sub` claim) — never the email, which
  // can change or be reused. This is the actual identity key for lookups.
  providerSub String
  // Encrypted Apple refresh token retained only to revoke Sign in with Apple on account deletion.
  providerRefreshTokenEncrypted String? @map("provider_refresh_token_encrypted") @db.Text
  // Snapshot of the verified email at link time, for display/support only — never used to look up
  // or match an identity; account linking keys off (provider, providerSub) plus a one-time,
  // explicit "does an existing User already have this verified email" check at link time (see
  // AuthService.googleLogin), not off this column on subsequent logins.
  email       String?
  createdAt   DateTime     @default(now())

  @@unique([provider, providerSub])
  @@index([userId])
  @@map("auth_identities")
}

// ---------- FastQue CRM / field operations ----------

model EmployeeProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  employeeCode String   @unique
  fullName     String
  territory    String?
  joinedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  crmLeads     EmployeeCrmLead[]
  crmVisits    EmployeeCrmVisit[]
  crmFollowUps EmployeeCrmFollowUp[]
  voiceVisitLogs EmployeeVoiceVisitLog[]
  crmTasks       CrmTask[]
  crmMeetings    CrmMeeting[]
  crmCalls       CrmCall[]
  salesRecordings SalesRecording[]
  onboardingApplications SalonOnboardingApplication[]

  @@map("employee_profiles")
}

model EmployeeCrmLead {
  id                String          @id @default(uuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  shopName          String
  contactName       String?
  phone             String?
  email             String?
  city              String?
  locality          String?
  addressLine       String?
  source            CrmLeadSource   @default(FIELD_VISIT)
  status            CrmLeadStatus   @default(NEW)
  notes             String?
  lostReason        String?
  onboardedSalonId  String?         @unique
  onboardedSalon    Salon?          @relation("CrmLeadOnboardedSalon", fields: [onboardedSalonId], references: [id], onDelete: SetNull)
  onboardedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  // CRM 2.0 — one central lead record; every call, meeting, task, visit, recording and the
  // onboarding application hang off it. All columns optional so existing leads stay valid.
  businessType      String?         @db.VarChar(40)
  ownerName         String?         @db.VarChar(120)
  managerName       String?         @db.VarChar(120)
  alternatePhone    String?         @db.VarChar(20)
  whatsappPhone     String?         @db.VarChar(20)
  state             String?         @db.VarChar(80)
  postalCode        String?         @db.VarChar(12)
  mapsUrl           String?         @db.VarChar(500)
  latitude          Float?
  longitude         Float?
  salonSize         String?         @db.VarChar(40)
  chairCount        Int?
  existingSoftware  String?         @db.VarChar(120)
  territory         String?         @db.VarChar(80)
  priority          CrmLeadPriority @default(NORMAL)
  interestLevel     Int?
  nextAction        String?         @db.VarChar(200)
  nextFollowUpAt    DateTime?
  lastContactedAt   DateTime?
  contactAttempts   Int             @default(0)
  meetingAt         DateTime?
  objections        String?         @db.VarChar(1000)
  assignedAt        DateTime?
  assignedByUserId  String?
  createdByUserId   String?
  importJobId       String?         @db.Uuid
  importJob         CrmLeadImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  visits            EmployeeCrmVisit[]
  followUps         EmployeeCrmFollowUp[]
  voiceVisitLogs    EmployeeVoiceVisitLog[]
  onboardingApplication SalonOnboardingApplication?
  activities        CrmLeadActivity[]
  tasks             CrmTask[]
  meetings          CrmMeeting[]
  calls             CrmCall[]
  recordings        SalesRecording[]
  tickets           SupportTicket[]

  @@index([employeeProfileId, status])
  @@index([employeeProfileId, createdAt])
  @@unique([id, employeeProfileId])
  @@index([phone])
  @@index([email])
  @@index([status, updatedAt])
  @@index([territory, status])
  @@index([city])
  @@index([nextFollowUpAt])
  @@index([importJobId])
  @@map("employee_crm_leads")
}

// Employee-owned, shop-scoped draft voice notes; never an approved/onboarded service catalog.
model EmployeeVoiceVisitLog {
  id                String          @id @default(uuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  leadId            String
  lead              EmployeeCrmLead @relation(fields: [leadId, employeeProfileId], references: [id, employeeProfileId], onDelete: Cascade)
  transcript        String          @db.Text
  structuredDraft   Json
  language          String          @default("hi-IN") @db.VarChar(16)
  status            String          @default("DRAFT") @db.VarChar(16)
  submissionKey     String?         @db.VarChar(80)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  confirmedAt       DateTime?

  @@unique([employeeProfileId, submissionKey])
  // Pinned to the 63-byte name PostgreSQL actually creates from migration 20261013160000 (the longer default name is
  // truncated by the server), so `prisma migrate diff` reports no rename for it.
  @@index([employeeProfileId, leadId, status, createdAt, id], map: "employee_voice_visit_logs_employeeProfileId_leadId_status_creat")
  @@map("employee_voice_visit_logs")
}

model EmployeeCrmVisit {
  id                String           @id @default(uuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              EmployeeCrmLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  shopName          String
  visitedAt         DateTime         @default(now())
  outcome           CrmVisitOutcome
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([employeeProfileId, visitedAt])
  @@index([leadId, visitedAt])
  @@map("employee_crm_visits")
}

model EmployeeCrmFollowUp {
  id                String             @id @default(uuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile    @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  leadId            String
  lead              EmployeeCrmLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueAt             DateTime
  channel           CrmFollowUpChannel
  status            CrmFollowUpStatus  @default(OPEN)
  notes             String?
  outcome           String?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([employeeProfileId, status, dueAt])
  @@index([leadId, dueAt])
  @@map("employee_crm_follow_ups")
}

model RefreshToken {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  tokenHash  String
  // Auth security fix — the session audience this token was originally issued for (CUSTOMER/
  // STAFF/ADMIN), persisted so rotation can re-scope roles to it rather than re-deriving privilege
  // from every role the User row currently holds. Every row created before this column existed was
  // revoked in the same migration that added it (see migration.sql) — its true audience is unknown
  // and is never guessed.
  //
  // The @default(CUSTOMER) here exists ONLY to keep this schema in sync with the DB-level DEFAULT
  // 'CUSTOMER' added by that same migration — a Railway-rollout-safety measure, not an application
  // behavior: TokenService.issueTokenPair always supplies an explicit audience for every row it
  // creates, so this default is only ever read if an old (pre-audience) binary is still inserting
  // rows during a deploy's migrate/cutover window (see migration.sql's own extensive comment). A
  // later, separate post-stabilization migration is expected to DROP this default once no such old
  // binary can serve again — see that migration's trailing note.
  audience   SessionAudience @default(CUSTOMER)
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime        @default(now())

  // Every login, refresh, revoke, and session-list call looks this table up by tokenHash
  // (TokenService) — the single hottest query in the whole auth system, and until this index it
  // ran as a full table scan. tokenHash is 256 bits of random hex, so a plain (non-unique) index
  // is sufficient — collisions are cryptographically negligible and the code never relies on
  // DB-level uniqueness (rotateRefreshToken's atomic updateMany already guards single-use via
  // revokedAt, not via a unique constraint on this column).
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model OtpRequest {
  id            String     @id @default(uuid())
  phone         String
  codeHash      String
  // Existing rows and old app instances use the legacy SHA-256 hash until they expire; new
  // requests use a keyed HMAC digest so a database-only disclosure cannot brute-force six digits.
  hashVersion   String     @default("LEGACY_SHA256")
  purpose       OtpPurpose
  subjectUserId String?
  subjectUser   User?      @relation("OtpRequestSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  attempts      Int        @default(0)
  expiresAt     DateTime
  verifiedAt    DateTime?
  createdAt     DateTime   @default(now())

  @@index([phone, createdAt])
  @@index([phone, purpose, createdAt])
  @@index([subjectUserId, purpose, createdAt])
  @@map("otp_requests")
}

// Privacy-minimal durable OTP send admission. It stores no phone, user, OTP, or provider detail.
// Rows are retained only for active budget windows and pruned transactionally on admission.
model OtpDeliveryAttempt {
  id                 String                   @id @default(uuid())
  countryCallingCode String
  status             OtpDeliveryAttemptStatus @default(RESERVED)
  createdAt          DateTime                 @default(now())
  finishedAt         DateTime?

  @@index([createdAt])
  @@index([countryCallingCode, createdAt])
  @@map("otp_delivery_attempts")
}

// Phase 2 addition — not in the original DATABASE.md field list. Needed to implement the
// approved "Forgot Password" flow for staff/owner/admin (customers never have a password, so
// never use this). Same pattern as RefreshToken/OtpRequest: only a hash of the token is stored,
// never the raw value, so a DB read alone can't be used to reset someone's password.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  onboardingInvitation SalonOnboardingInvitation?

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// ---------- Discovery / SEO ----------

// Global location master data (Phase 1 of the Country -> Region -> City -> Locality
// architecture). Additive only: every field here is nullable and every existing City column/
// constraint below is untouched. Country/Region are not populated yet — that is a separate,
// explicitly-approved future import phase (see import-global-locations.ts, not yet created).
model Country {
  id              String   @id @default(uuid())
  isoCode2        String   @unique
  isoCode3        String?  @unique
  name            String
  nativeName      String?
  phoneCode       String?
  currencyCode    String?
  continent       String?
  subregion       String?
  hasSubdivisions Boolean  @default(false)
  slug            String   @unique
  // Not yet consumed anywhere — a future enrichment candidate for packages/shared's
  // hand-written postalCodeRuleFor, not a replacement for it in this phase.
  postalCodeRegex String?
  // Provenance for imported rows; deliberately NOT unique (see CityAlias/Region below — a
  // source id is only stable within one dataset+version, never a cross-dataset key).
  sourceDataset   String?
  sourceId        Int?
  sourceVersion   String?
  wikiDataId      String?
  regions         Region[]
  cities          City[]
}

// state / province / emirate / oblast / prefecture / territory — one flexible concept, not a
// hierarchy of subtypes. `code` is ISO-3166-2 where the source dataset provides one; never
// invented for a region that doesn't have one.
model Region {
  id            String  @id @default(uuid())
  countryId     String
  country       Country @relation(fields: [countryId], references: [id])
  code          String?
  name          String
  nativeName    String?
  // The source dataset's own subdivision type label (e.g. "state", "province", "emirate"),
  // stored as-is rather than normalized into an enum BarberCue would have to keep in sync with
  // every country's own administrative vocabulary.
  kind          String?
  slug          String
  sourceDataset String?
  sourceId      Int?
  sourceVersion String?
  wikiDataId    String?
  cities        City[]

  @@unique([countryId, slug])
  @@index([countryId])
}

enum CityAliasKind {
  NATIVE_NAME
  TRANSLITERATION
  HISTORICAL
  COMMON_MISSPELLING
}

// Alternate names for a City (native-script, transliteration, historical, common misspelling)
// so e.g. Mumbai / मुंबई / Bombay can all resolve to the same row without cramming multiple
// names into City.name. Not populated in Phase 1 — see the Phase-1 design report.
model CityAlias {
  id     String        @id @default(uuid())
  cityId String
  city   City          @relation(fields: [cityId], references: [id])
  name   String
  kind   CityAliasKind

  @@index([cityId])
  @@index([name])
}

model City {
  id          String     @id @default(uuid())
  name        String
  // No longer globally unique: two countries legitimately share a city name (London GB vs
  // London CA, Birmingham GB vs Birmingham US), so uniqueness is scoped by country below.
  slug        String
  // ISO-3166-1 alpha-2. The field logic keys on — `country` below stays as free-text display
  // data. Required: a city with no country cannot be validated, priced, or routed.
  countryCode String
  // ISO-3166-2 subdivision where known. Nullable — many countries have no useful subdivision,
  // and inventing one would be fabricated data.
  regionCode  String?
  state       String
  country     String
  localities  Locality[]
  salons      Salon[]

  // ---- Global location master data (Phase 1, additive) ----
  // Nullable and unpopulated until the separate, explicitly-approved global import phase.
  // countryCode/regionCode/state/country above remain the only fields anything reads today.
  countryId     String?
  countryRef    Country?    @relation(fields: [countryId], references: [id])
  regionId      String?
  regionRef     Region?     @relation(fields: [regionId], references: [id])
  nativeName    String?
  latitude      Float?
  longitude     Float?
  // IANA timezone (e.g. "America/Chicago"), sourced from the same dr5hn import as
  // latitude/longitude above (Part 4, auto timezone selection). Nullable: only populated for
  // cities the global-location importer has enriched — legacy/demo cities and any city imported
  // before this column existed have none until a separate, explicitly-approved backfill runs.
  // This is city-level metadata, never a per-salon override — Salon.timezone remains the
  // authoritative, owner-configurable value; this only feeds the auto-detection suggestion.
  timezone      String?
  population    Int?
  sourceDataset String?
  sourceId      Int?
  sourceVersion String?
  wikiDataId    String?
  aliases       CityAlias[]

  @@unique([countryCode, slug])
  // Phase 1 addition, parallel to the constraint above during the deprecation period. Safe with
  // countryId nullable: Postgres does not compare NULLs against each other for uniqueness, so
  // every existing City row (countryId = NULL) is unaffected until backfilled.
  @@unique([countryId, slug])
  @@index([countryCode])
  // Serves the interim CitiesService.findFirst({ slug }) lookup. The composite above cannot:
  // `slug` is not its leading column. Remove once B9's country-scoped routes make every city
  // lookup carry a countryCode.
  @@index([slug])
  @@index([countryId])
  @@index([regionId])
  @@map("cities")
}

model Locality {
  id     String  @id @default(uuid())
  cityId String
  city   City    @relation(fields: [cityId], references: [id])
  name   String
  slug   String
  salons Salon[]

  @@unique([cityId, slug])
  @@map("localities")
}

model Salon {
  id                                String      @id @default(uuid())
  // Permanent, human-shareable identifier — "BC-SHOP-000001" — distinct from `id` (the internal
  // UUID primary key, never shown to users). Assigned once at creation by a Postgres sequence (see
  // the add_salon_public_id migration's hand-written SQL default), so uniqueness/monotonicity are
  // guaranteed by the database, not application code — no read-max-then-increment race. Nothing in
  // SalonsService ever writes this column after creation, so it's immutable in practice.
  // dbgenerated() here is a type-only marker (Prisma never emits migration SQL for it) telling
  // Prisma Client the column has a DB-level default — the real default is the raw SQL in the
  // add_salon_public_id migration; this just makes `publicId` optional in create() calls instead
  // of forcing every caller to invent a value.
  publicId                          String      @unique @default(dbgenerated("('BC-SHOP-' || lpad(nextval('salon_public_id_seq'::regclass)::text, 6, '0'))"))
  // Phase 9: the shop's permanent QR/public-queue-join identifier — deliberately NOT `publicId`
  // above (that's a sequential, enumerable counter; guessable, unsuitable for a link anyone can
  // join a queue through) and NOT `id` (the internal PK, never exposed publicly). Nullable +
  // lazily generated server-side (PublicQueueTokenService, via Node's crypto.randomBytes — same
  // convention as auth.service.ts's password-reset token) rather than a DB sequence default,
  // since a cryptographically random value isn't a Postgres built-in without the pgcrypto
  // extension. Nullable-unique is safe: Postgres allows multiple NULLs under a unique index (same
  // pattern as CancellationPolicy.salonId).
  publicQueueToken                  String?     @unique
  ownerUserId                       String
  owner                             User        @relation("SalonOwner", fields: [ownerUserId], references: [id])
  name                              String
  slug                              String
  cityId                            String
  city                              City        @relation(fields: [cityId], references: [id])
  localityId                        String?
  locality                          Locality?   @relation(fields: [localityId], references: [id])
  // Owner-entered neighbourhood/area. Kept separately from localityId because the global master
  // dataset is advisory for onboarding; a real shop must be able to enter an area that is not yet
  // present in Locality. localityId is still populated when the text matches a known locality.
  localityText                      String?     @db.VarChar(160)
  // Human navigation hint such as "Near Hanuman Mandir" or "Opposite City Mall".
  landmark                          String?     @db.VarChar(200)
  addressLine                       String
  // IANA timezone (e.g. "Asia/Kolkata", "Europe/London"). Nullable for now: nothing can yet
  // derive a zone at registration — GPS is optional and no lookup service is wired — so
  // requiring it would break registerSalon. AvailabilityService still uses a fixed IST offset
  // and does NOT read this column yet; that switch is a separate, reviewed change.
  timezone                          String?
  // Part 4 (auto timezone selection) provenance flags — never used to gate behavior on their own,
  // only to decide whether a future auto-detect pass may safely replace the current value.
  // `timezoneAutoDetected`: true iff the current `timezone` value was set by resolveAutoTimezone
  // (coordinates/city/country), never by an explicit owner/admin PATCH.
  // `timezoneManuallyOverridden`: true once an owner/admin has ever explicitly PATCHed timezone —
  // once set, auto-detection must never silently overwrite the stored value again.
  timezoneAutoDetected              Boolean     @default(false)
  timezoneManuallyOverridden        Boolean     @default(false)
  // ISO-4217 (e.g. "INR", "GBP"). Nullable for the same reason: no source populates it yet.
  // Money columns are already Decimal and currency-agnostic; this records which currency they
  // are denominated in.
  currency                          String?
  // Indian 6-digit PIN code. Stored as text, never a number: PIN codes are identifiers, not
  // quantities, and several legitimately need a meaning-bearing shape a numeric type would
  // mangle. Nullable because every salon registered before this column existed has none, and
  // backfilling one would mean inventing an address detail nobody supplied.
  postalCode                        String?
  // Nullable since Phase 11: coordinates now come from the device's GPS via the registration
  // form's "Use my current location" button, and an owner who denies that permission (or is on a
  // desktop) must still be able to register. Their only consumer is the schema.org `geo` block on
  // the public salon page — there is no distance search, map, or proximity sort in the product —
  // so a salon without them is fully functional, just slightly less rich to search engines.
  lat                               Float?
  lng                               Float?
  phone                             String?
  // Business contact email, distinct from the owner User's own login email — same "optional
  // business-facing contact field" pattern as `phone` above. Added for shop registration
  // (Phase C); not required, since not every shop has a dedicated reception inbox.
  email                             String?
  description                       String?
  status                            SalonStatus @default(PENDING)
  // Owner-controlled same-day pause. Unlike SalonStatus.SUSPENDED (platform/admin moderation),
  // this never removes an otherwise ACTIVE shop from public discovery. Customer-facing surfaces
  // keep the shop visible with an explicit "This shop is closed for today." notice, while booking
  // and queue entry are blocked until the owner reopens it.
  isClosedForToday                  Boolean     @default(false)
  // Owner-controlled intake pauses while the shop itself stays open. They stop NEW customer joins /
  // NEW online bookings only; existing bookings, the current queue and entries the shop adds itself
  // are untouched.
  queuePaused                       Boolean     @default(false)
  bookingsPaused                    Boolean     @default(false)
  // Owner-selected service audience used to filter onboarding presets. Existing salons default to
  // UNISEX so the migration is backwards-compatible and never hides already-configured services.
  salonType                         SalonType   @default(UNISEX)
  // Discovery upgrade: true once an owner has actually chosen salonType (at registration or in
  // settings). Every salon created before this column existed starts false, because its UNISEX value
  // is only the column default — discovery must not present it as a confirmed unisex salon.
  salonTypeConfirmed                Boolean     @default(false)
  // Percentage discount applied by FastQue only to APP/WEB bookings for this salon. The Service
  // rows remain the owner's original list prices; 0 means no platform-booking offer is active.
  onlineBookingDiscountPercent      Int         @default(0)
  // Photo activation policy. NULL is the additive-migration marker for shops that existed before
  // this requirement: ACTIVE/SUSPENDED lifecycle state identifies them as grandfathered without
  // rewriting legacy rows. A newly activated shop is marked true after meeting the requirement.
  shopPhotoRequirementGrandfathered Boolean?
  // Owner-operations mission. showPhoneToCustomers: the owner's opt-in to publish `phone` to
  // customers (public profile + "Call shop" on their own booking). Defaults to true because the
  // phone was already public before this column existed — the migration changes no behavior; an
  // owner can now switch it off. queueAutoAssignEnabled: automatic barber/chair allocation for
  // customers who are physically present. Default ON for every new shop (owner decision, 13 Oct
  // 2026); the owner can switch it off and on again. Automatic allocation only ASSIGNS - a barber
  // still starts the service explicitly. Migration 20261014000000 moved the default from OFF to ON
  // without overwriting any shop with a recorded owner choice (see docs/OWNER_OPERATIONS.md).
  showPhoneToCustomers              Boolean     @default(true)
  queueAutoAssignEnabled            Boolean     @default(true)
  // Live-visit add-on mission (17 Nov 2026). Minutes kept free after every service so an add-on a
  // customer asks for at the chair (beard, head massage...) never delays the next appointment; when
  // nobody adds anything the barber uses it to sanitise tools or take a short break. Applied as a
  // planning gap only: new bookings/reschedules keep this gap from every other reservation of the
  // same pool/barber, and a walk-in is only started on a barber when service + gap still ends before
  // that barber's next appointment. 0 = exactly the behaviour before this column existed.
  serviceBufferMinutes              Int         @default(10)

  // Subscription fields — inert in V1, see ARCHITECTURE.md §16.
  planId                String?
  plan                  Plan?              @relation(fields: [planId], references: [id])
  subscriptionStatus    SubscriptionStatus @default(PILOT)
  trialEndsAt           DateTime?
  subscriptionExpiresAt DateTime?
  gracePeriodEndsAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles                   UserRole[]
  staff                       SalonStaff[]
  chairs                      Chair[]
  services                    Service[]
  serviceCategories           SalonServiceCategory[]
  reviewProfiles              SalonReviewProfile?
  offers                      Offer[]
  contactConsents              ContactConsentRecord[]
  bookings                    Booking[]
  bookingAttributionCampaigns BookingAttributionCampaign[]
  queueEntries                QueueEntry[]
  cancellationPolicies        CancellationPolicy[]
  paymentPolicy               SalonPaymentPolicy?
  operatingHours              OperatingHours[]
  photos                      Photo[]
  locationProposals           SalonLocationProposal[]
  reviews                     Review[]
  ledgerEntries               CustomerLedgerEntry[]
  staffChairAssignments       StaffChairAssignment[]
  // Phase 18 — at most one row (VerificationRequest.salonId is @@unique; NULL salonId rows, i.e.
  // PROFESSIONAL-type requests, are unaffected by that constraint under Postgres NULLS DISTINCT).
  verification                VerificationRequest?
  subsidyEntries              PlatformShopSubsidyEntry[]
  manualChairOccupancies      ManualChairOccupancy[]
  // FastQue internal field CRM attribution — at most one employee lead may claim a registered shop.
  crmLeadAttribution          EmployeeCrmLead?             @relation("CrmLeadOnboardedSalon")
  favoritedBy                 CustomerFavorite[]
  recentViews            CustomerRecentSalonView[]
  billingProfile              SalonBillingProfile?
  invoices                    Invoice[]
  inventoryCategories         InventoryCategory[]
  inventorySuppliers          InventorySupplier[]
  inventoryProducts           InventoryProduct[]
  inventoryMovements          InventoryMovement[]
  globalProductSubmissions GlobalProduct[] @relation("GlobalProductSubmissions")
  shopCatalogProducts      GlobalProduct[] @relation("GlobalProductOwnerSalon")
  catalogChangeRequests    CatalogChangeRequest[]
  shopListings             ShopListing[]
  shopOrders               ShopOrder[]
  serviceProductRules      ServiceProductRule[]
  serviceUsages            ServiceUsage[]
  inventorySettings        InventorySettings?
  inventoryAlerts          InventoryAlert[]
  demoWorkspace               OwnerDemoWorkspace?
  onboardingApplication       SalonOnboardingApplication?
  homeProvider                HomeProvider?

  @@unique([cityId, slug])
  @@map("salons")
}

model SalonPaymentPolicy {
  id                    String                @id @default(uuid())
  salonId               String                @unique
  salon                 Salon                 @relation(fields: [salonId], references: [id])
  prepaymentRequirement PrepaymentRequirement @default(NONE)
  prepaymentPercentage  Int?
  // FastQue Credits / Wallet V1 — the shop's own UPI/payment QR image, shown to a customer paying
  // directly for an ONLINE (APP/WEB-sourced) booking. There is no live payment gateway yet (see
  // Payment/Refund above: schema-only, unimplemented — PAYMENTS.md's Razorpay design is not coded),
  // so online payment collection is manual QR-scan-and-pay, and BookingsService.create refuses to
  // create an ONLINE booking (source APP or WEB) at any salon that hasn't configured one
  // (BookingErrorCode.PAYMENT_QR_REQUIRED) — a real backend guard, not just a UI hint. WALK_IN
  // bookings are unaffected. Same "URL-based, no object storage configured" convention as
  // Photo.url, with the same link-or-upload dual path as SalonPhotosService — one column, two ways
  // to fill it.
  paymentQrImageUrl     String?
  // Optional direct UPI routing. QR-only salons remain valid; no settlement verification.
  upiVpa                String?               @db.VarChar(255)
  upiPayeeName          String?               @db.VarChar(100)

  @@map("salon_payment_policies")
}

model CancellationPolicy {
  id                             String     @id @default(uuid())
  salonId                        String?    @unique
  salon                          Salon?     @relation(fields: [salonId], references: [id])
  freeCancellationWindowMinutes  Int
  lateCancellationChargeType     ChargeType
  lateCancellationChargeValue    Decimal    @db.Decimal(10, 2)
  noShowChargeType               ChargeType
  noShowChargeValue              Decimal    @db.Decimal(10, 2)
  appointmentArrivalGraceMinutes Int
  queueCallResponseGraceMinutes  Int
  createdAt                      DateTime   @default(now())
  updatedAt                      DateTime   @updatedAt

  @@map("cancellation_policies")
}

model OperatingHours {
  id        String  @id @default(uuid())
  salonId   String
  salon     Salon   @relation(fields: [salonId], references: [id])
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  @@unique([salonId, dayOfWeek])
  @@map("operating_hours")
}

// Phase 7 (barber schedules) — an optional per-barber refinement layer on top of the salon's own
// OperatingHours, not a replacement for it. Deliberately opposite default from OperatingHours: a
// day with NO row here means "unrestricted — this barber works whenever the shop is open," not
// closed, since personal hours are an owner-configured refinement most barbers will never touch.
// Same shape/convention as OperatingHours (dayOfWeek 0=Sunday..6=Saturday, "HH:mm" strings).
model StaffWorkingHours {
  id        String     @id @default(uuid())
  staffId   String
  staff     SalonStaff @relation(fields: [staffId], references: [id])
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean    @default(false)

  @@unique([staffId, dayOfWeek])
  @@map("staff_working_hours")
}

model Photo {
  id        String    @id @default(uuid())
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id])
  url       String
  altText   String?
  type      PhotoType
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@map("photos")
}

// ---------- Staff / chairs (approved concepts, unchanged) ----------

model SalonStaff {
  id                String            @id @default(uuid())
  salonId           String
  salon             Salon             @relation(fields: [salonId], references: [id])
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  displayName       String
  roleInSalon       SalonStaffRole
  status            StaffMemberStatus @default(ACTIVE)
  // Phase 17 (Barber Professional Profile) — all optional/additive. Which services this barber is
  // actually qualified for already lives in StaffService, a real DB-backed relation; these are the
  // genuinely new fields (no existing model covered them). photoUrl follows the same "URL-based,
  // no object storage configured" convention as Salon photos — an owner/staff links an
  // already-hosted image rather than uploading a file.
  bio               String?
  photoUrl          String?
  yearsExperience   Int?
  // Owner-operations mission — login access, distinct from `status`. `status` is the barber's
  // clock-in/out duty flag (a barber toggles it themselves all day); revoking access is an owner
  // decision that removes the SALON_STAFF UserRole and the barber's staff sessions, and is
  // recorded here so re-activation is explicit and auditable. NULL = access intact.
  accessRevokedAt   DateTime?
  accessRevokedById String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  chairAssignments     StaffChairAssignment[]
  serviceSessions      ServiceSession[]
  services             StaffService[]
  queueEntriesAssigned QueueEntry[]           @relation("AssignedStaff")
  preferredByBookings  Booking[]              @relation("BookingPreferredStaff")
  workingHours         StaffWorkingHours[]
  // Phase 18 — at most one row (VerificationRequest.staffId is @@unique).
  verification         VerificationRequest?
  serviceUsages        ServiceUsage[]
  homeProfessional     HomeProfessional?

  @@map("salon_staff")
}

model Chair {
  id        String      @id @default(uuid())
  salonId   String
  salon     Salon       @relation(fields: [salonId], references: [id])
  label     String
  status    ChairStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  assignments          StaffChairAssignment[]
  serviceSessions      ServiceSession[]
  queueEntriesAssigned QueueEntry[]           @relation("AssignedChair")
  manualOccupancies    ManualChairOccupancy[]

  @@map("chairs")
}

// A local/off-platform customer can physically occupy a chair without having a FastQue
// QueueEntry/ServiceSession. This record is deliberately separate from Chair.status: ACTIVE /
// INACTIVE / MAINTENANCE describes whether the chair is usable at all, not whether someone is
// sitting in it right now. endedAt NULL means currently occupied. A partial unique index in
// the migration enforces one active manual occupancy per chair; QueueService and
// ManualChairOccupancyService additionally share a per-chair Postgres advisory lock so an
// ACTIVE ServiceSession and a manual occupancy cannot win a cross-table race simultaneously.
model ManualChairOccupancy {
  id              String    @id @default(uuid())
  salonId         String
  salon           Salon     @relation(fields: [salonId], references: [id])
  chairId         String
  chair           Chair     @relation(fields: [chairId], references: [id])
  startedByUserId String
  startedBy       User      @relation("ManualChairOccupancyStartedBy", fields: [startedByUserId], references: [id])
  endedByUserId   String?
  endedBy         User?     @relation("ManualChairOccupancyEndedBy", fields: [endedByUserId], references: [id])
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([salonId, endedAt])
  @@index([chairId, endedAt])
  @@map("manual_chair_occupancies")
}

model StaffChairAssignment {
  id            String     @id @default(uuid())
  salonId       String
  salon         Salon      @relation(fields: [salonId], references: [id])
  staffId       String
  staff         SalonStaff @relation(fields: [staffId], references: [id])
  chairId       String
  chair         Chair      @relation(fields: [chairId], references: [id])
  shiftDate     DateTime   @db.Date
  assignedFrom  DateTime
  assignedUntil DateTime?
  createdAt     DateTime   @default(now())

  @@map("staff_chair_assignments")
}

model Service {
  id                 String                   @id @default(uuid())
  salonId            String
  salon              Salon                    @relation(fields: [salonId], references: [id])
  name               String
  description        String?
  durationMinutes    Int
  price              Decimal                  @db.Decimal(10, 2)
  category           String?
  // Optional refinement for existing free-text service categories; null preserves all legacy rows.
  subcategory        String?
  // Canonical salon-owned taxonomy references. Legacy text fields remain the compatibility and
  // display source; composite relations prevent accidentally attaching a service to another salon's
  // category, and the migration links existing labels without rewriting them.
  categoryId         String?
  subcategoryId      String?
  serviceCategory    SalonServiceCategory?    @relation(fields: [salonId, categoryId], references: [salonId, id], onDelete: Restrict, onUpdate: Cascade)
  serviceSubcategory SalonServiceSubcategory? @relation(fields: [salonId, categoryId, subcategoryId], references: [salonId, categoryId, id], onDelete: Restrict, onUpdate: Cascade)
  isActive           Boolean                  @default(true)
  // Future-proofing only (DATABASE.md): caps a service below the staff/chair-derived capacity for
  // a service that needs a scarce fixed resource. Unset for every V1 service.
  maxConcurrent      Int?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  staffQualifications StaffService[]
  bookings            Booking[]
  queueEntries        QueueEntry[]
  serviceSessions     ServiceSession[]
  // Multi-service booking core mission — see BookingService's own doc comment.
  bookingServices     BookingService[]
  offerServices       OfferService[]
  // Inventory Phase 2 — product recipe lines and the products recorded as used.
  productRules        ServiceProductRule[]
  productUsages       ServiceUsage[]
  queueEntryAddOns    QueueEntryAddOn[]

  @@index([salonId, categoryId, subcategoryId])
  @@unique([salonId, id])
  @@map("services")
}

// Canonical, salon-scoped catalog nodes. Names are owner-controlled labels; normalizedName is a
// deterministic case-insensitive identity used for uniqueness, never a user-facing value.
model SalonServiceCategory {
  id             String   @id @default(uuid())
  salonId        String
  salon          Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  // TEXT keeps legacy source labels representable even if they predate the current 60-char API cap.
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subcategories SalonServiceSubcategory[]
  services      Service[]

  @@unique([salonId, id])
  @@unique([salonId, normalizedName])
  @@index([salonId, name])
  @@map("service_categories")
}

model SalonServiceSubcategory {
  id             String               @id @default(uuid())
  salonId        String
  categoryId     String
  category       SalonServiceCategory @relation(fields: [salonId, categoryId], references: [salonId, id], onDelete: Restrict, onUpdate: Cascade)
  name           String
  normalizedName String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  services Service[]

  @@unique([categoryId, normalizedName])
  @@unique([salonId, categoryId, id])
  @@index([salonId, categoryId, name])
  @@map("service_subcategories")
}

model StaffService {
  staffId   String
  staff     SalonStaff @relation(fields: [staffId], references: [id])
  serviceId String
  service   Service    @relation(fields: [serviceId], references: [id])

  @@id([staffId, serviceId])
  @@map("staff_services")
}

// ---------- Booking & queue ----------

model Booking {
  id                           String                      @id @default(uuid())
  salonId                      String
  salon                        Salon                       @relation(fields: [salonId], references: [id])
  // Owner-operations mission: nullable ONLY for BookingSource.IN_SHOP appointments created by a
  // shop operator for someone without a FastQue account (a CHECK constraint in the migration ties
  // `customerId IS NULL` to `source = 'IN_SHOP'`, so every APP/WEB booking still has a customer
  // exactly as before). No placeholder/fake User row is ever created for such a guest.
  customerId                   String?
  customer                     User?                       @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  // Multi-service booking core mission: kept exactly as it was — the FIRST service the customer
  // selected (ordering preserved via BookingService.sortOrder), never removed or made nullable, so
  // every consumer that predates multi-service bookings (QueueEntry/ServiceSession linkage at
  // check-in, admin/analytics "recent activity" feeds, the customer ledger's per-charge service
  // label) keeps working unchanged against a real, meaningful value rather than an arbitrary one.
  // The booking's true, authoritative service selection is the `services` relation below — this
  // column is a read compatibility view onto its first entry, not a second source of truth: both
  // are written together, once, inside the same create() transaction, and neither is ever updated
  // independently afterwards.
  serviceId                    String
  service                      Service                     @relation(fields: [serviceId], references: [id])
  // Multi-service booking core mission — the complete, ordered set of services actually selected
  // for this appointment (see BookingService's own doc comment for why it snapshots rather than
  // joins live). Every booking has at least one row here, including every booking that existed
  // before this relation did — the migration that introduced this table backfilled one row per
  // existing booking from its (still-present, unchanged) serviceId/service at that time.
  services                     BookingService[]
  slotStart                    DateTime
  slotEnd                      DateTime
  status                       BookingStatus               @default(CONFIRMED)
  source                       BookingSource
  // Optional, additive marketing provenance. Booking.source remains the operational source used
  // by older Android/web clients; this relation only records an external campaign token that the
  // server validated for this exact salon at creation time.
  attributionCampaignId        String?
  attributionCampaign          BookingAttributionCampaign? @relation(fields: [salonId, attributionCampaignId], references: [salonId, id], onDelete: Restrict, map: "bookings_attributionCampaignId_fkey")
  idempotencyKey               String                      @unique
  // Snapshot of SalonPaymentPolicy x Service.price at creation time — see DATABASE.md.
  prepaymentRequiredAmount     Decimal?                    @db.Decimal(10, 2)
  // Phase 3B addition: a soft customer preference only, never a capacity constraint — the booking
  // capacity model above stays pool-based (min qualified staff, active chairs), unchanged. Real
  // staff/chair assignment still only happens at queue check-in/dashboard-assign time. Null means
  // "Any Staff". See DATABASE.md's Booking section for the full rationale.
  preferredStaffId             String?
  preferredStaff               SalonStaff?                 @relation("BookingPreferredStaff", fields: [preferredStaffId], references: [id])
  // AI Style Advisor phase: the style label the customer picked before booking (e.g. "Textured
  // Crop"), carried through so staff can see it on the dashboard queue view. A free-text snapshot
  // of a small fixed list in packages/shared, not a foreign key — no salon-configurable "style
  // catalog" table exists or is needed for a short, app-wide list of style names.
  selectedStyleName            String?
  cancelledAt                  DateTime?
  cancelledById                String?
  cancelledBy                  User?                       @relation("BookingCancelledBy", fields: [cancelledById], references: [id])
  cancellationChargeAmount     Decimal?                    @db.Decimal(10, 2)
  // Owner-operations mission — trusted cancellation attribution, written in the same transaction
  // as the status change from the authenticated actor. See the CancellationActor enum.
  cancelledByActor             CancellationActor?
  cancellationReason           String?                     @db.VarChar(300)
  // Owner-operations mission — IN_SHOP appointment provenance. guestName/guestPhone are the
  // contact the shop typed in; guestContactConsent records that the customer agreed to be
  // contacted/stored (phone is only ever kept when this is true). createdByUserId is the operator
  // who created it (plain column, no relation: keeps the User model untouched). internalNote is
  // staff-only and never returned by any customer-facing API.
  guestName                    String?                     @db.VarChar(120)
  guestPhone                   String?                     @db.VarChar(32)
  guestContactConsent          Boolean                     @default(false)
  createdByUserId              String?
  internalNote                 String?                     @db.VarChar(500)
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  // Phase 12 (Appointment Reminders) — set once the reminder sweep has notified this booking's
  // customer, so the periodic sweep never double-reminds. Null means "not sent yet", not "no
  // reminder wanted" — every eligible booking gets exactly one until it's sent.
  reminderSentAt               DateTime?
  // P0 arrival-alert mission — set once the T-5-minute arrival-check sweep has notified this
  // salon's operators, so the periodic sweep never re-sends the same one-shot nudge (realtime +
  // durable Notification + mobile push) on every run. Null means "not sent yet". Unlike
  // reminderSentAt this never gates whether the FULL-SCREEN overlay itself shows — that eligibility
  // is always re-derived live (CONFIRMED, no QueueEntry, now >= slotStart - lead) so a reconnect or
  // hard refresh can never lose an unresolved alert; this column only dedupes the one-time push.
  arrivalAlertSentAt           DateTime?
  // FastQue Credits / Wallet V1 — a snapshot, not a live-recomputed value, so a later change to
  // CREDIT_SLAB_AMOUNT_INR or the wallet balance can never retroactively change what a past
  // booking shows it redeemed. Set once, at creation, to the ACTUAL amount applied after the
  // server clamped the customer's request to min(requested, live balance, the price-based
  // redemption cap) — never the raw client-requested amount. Null means "redeemed nothing", not
  // "unknown". There is deliberately no "credits earned" snapshot: completing a service does not
  // automatically grant credits in this product (see CreditTransactionType.PROMO_GRANT) — credits
  // only ever enter a wallet through an authorized promotional grant or a redemption restoration.
  creditsRedeemedAmount        Decimal?                    @db.Decimal(10, 2)
  // Shop-funded promotional discount active when this booking was created. These are immutable
  // snapshots: later enabling/disabling/changing the salon offer never rewrites booking history.
  onlineBookingDiscountPercent Int                         @default(0)
  onlineBookingDiscountAmount  Decimal                     @default(0) @db.Decimal(10, 2)
  // Optional applied offer. The title and amount are snapshots: later edits or expiry never
  // rewrite the historical booking total. Existing clients ignore these additive fields.
  offerId                      String?
  offer                        Offer?                      @relation(fields: [salonId, offerId], references: [salonId, id], onDelete: Restrict)
  offerTitle                   String?                     @db.VarChar(120)
  // Part 5 completion (arrival guidance) — same snapshot rationale as prepaymentRequiredAmount/
  // cancellationChargeAmount/creditsRedeemedAmount above: captured once, at creation time, from
  // whatever rule was actually in effect then, so a later change to the salon's
  // CancellationPolicy.appointmentArrivalGraceMinutes (or, in principle, the platform-wide
  // EARLY_CHECKIN_WINDOW_MINUTES constant) can never retroactively change what a past booking's
  // "please arrive by" / "check in from" guidance displays. Null on any booking created before
  // this column existed — such a booking shows no arrival guidance at all rather than guessing
  // from the CURRENT policy, which could be wrong for what the customer was actually told.
  checkInOpensMinutesBefore    Int?
  checkInDueGraceMinutes       Int?

  queueEntries       QueueEntry[]
  payments           Payment[]
  reviews            Review[]
  ledgerEntries      CustomerLedgerEntry[]
  creditTransactions CustomerCreditTransaction[]
  subsidyEntry       PlatformShopSubsidyEntry?
  invoices           Invoice[]
  offerRedemption    OfferRedemption?

  @@index([salonId, slotStart, slotEnd])
  @@index([salonId, status, cancelledAt])
  @@index([salonId, createdAt])
  @@index([salonId, attributionCampaignId, createdAt])
  @@unique([salonId, id])
  @@map("bookings")
}

// Salon-funded, provider-free marketing offers, promotions and Daily Deals. A redemption is
// reserved atomically when an authenticated customer booking is accepted; no payment provider is
// called. Booking stores its own title/discount snapshots so pausing or editing a campaign never
// rewrites history.
model Offer {
  id                String            @id @default(uuid())
  salonId           String
  salon             Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  kind              OfferKind
  status            OfferStatus       @default(DRAFT)
  title             String            @db.VarChar(120)
  description       String?           @db.VarChar(500)
  discountType      OfferDiscountType
  discountValue     Decimal           @db.Decimal(10, 2)
  currency          String            @db.VarChar(3)
  audience          OfferAudience     @default(ALL)
  inactiveDays      Int?
  validFrom         DateTime          @db.Timestamptz(6)
  validTo           DateTime          @db.Timestamptz(6)
  maxRedemptions    Int?
  perCustomerLimit  Int               @default(1)
  createdByUserId   String
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)

  services          OfferService[]
  bookings          Booking[]
  redemptions       OfferRedemption[]

  @@unique([salonId, id])
  @@index([salonId, status, validFrom, validTo, id])
  @@index([salonId, createdAt, id])
  @@map("offers")
}

model OfferService {
  salonId   String
  offerId   String
  offer     Offer   @relation(fields: [salonId, offerId], references: [salonId, id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [salonId, serviceId], references: [salonId, id], onDelete: Restrict)

  @@id([offerId, serviceId])
  @@index([salonId, serviceId, offerId])
  @@map("offer_services")
}

model OfferRedemption {
  id              String   @id @default(uuid())
  salonId         String
  offerId         String
  offer           Offer    @relation(fields: [salonId, offerId], references: [salonId, id], onDelete: Restrict)
  bookingId       String
  booking         Booking  @relation(fields: [salonId, bookingId], references: [salonId, id], onDelete: Restrict)
  customerId      String
  customer        User     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  discountAmount  Decimal  @db.Decimal(10, 2)
  currency        String   @db.VarChar(3)
  redeemedAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([salonId, offerId, redeemedAt])
  @@index([salonId, customerId, redeemedAt])
  @@index([offerId, customerId, redeemedAt])
  @@unique([salonId, bookingId])
  @@map("offer_redemptions")
}

// Owner-generated, salon-scoped referral campaigns. Only a SHA-256 digest is stored; the
// high-entropy token is returned once on creation and is not an authentication credential.
model BookingAttributionCampaign {
  id              String                           @id @default(uuid())
  salonId         String
  salon           Salon                            @relation(fields: [salonId], references: [id], onDelete: Restrict)
  source          BookingAttributionCampaignSource
  label           String                           @db.VarChar(120)
  tokenHash       String                           @unique @db.Char(64)
  createdByUserId String
  startsAt        DateTime?
  endsAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt
  bookings        Booking[]

  @@unique([salonId, id])
  @@index([salonId, createdAt])
  @@index([salonId, source, revokedAt])
  @@map("booking_attribution_campaigns")
}

// Multi-service booking core mission — one row per service actually selected on a Booking, in
// customer-chosen order (sortOrder). This is the authoritative multi-service record; Booking.
// serviceId/service (above) remains a read-compatibility pointer at its first entry only.
//
// Snapshotted, not a live join: serviceName/durationMinutes/price are copied from the Service at
// booking-creation time and never updated afterwards, for the exact same reason every other
// Booking-time snapshot in this file exists (prepaymentRequiredAmount, checkInOpensMinutesBefore,
// etc.) — a later rename/reprice/deactivation of the Service must never retroactively change what
// a past booking is shown to have cost or included. serviceId is still a real FK (never dropped
// even if the Service is later deactivated) purely for traceability/joins; every display field a
// UI needs comes from the snapshot columns, never from re-reading the live Service row.
//
// @@unique([bookingId, serviceId]): the same service cannot appear twice on one appointment — a
// customer wanting "two haircuts" is not a supported product concept in V1 (one appointment is one
// visit with one ordered set of distinct services), and this constraint makes that a database
// guarantee, not just a validation-layer convention (see AvailabilityService.getServicesOrThrow,
// the one place a candidate serviceIds[] is checked for duplicates before ever reaching here).
model BookingService {
  id              String   @id @default(uuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id])
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  // 0-based selection order — which service is "first" (and therefore mirrored onto Booking.
  // serviceId) is never ambiguous or re-derived from creation timestamps.
  sortOrder       Int
  serviceName     String
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  @@unique([bookingId, serviceId])
  @@index([bookingId])
  @@map("booking_services")
}

// ---------- FastQue Credits / Wallet V1 ----------
//
// A promotional customer wallet, deliberately NOT built on CustomerLedgerEntry: that model is
// customer DUES (money owed BY the customer for a no-show/late cancellation — see its own doc
// comment), the semantic opposite of a credit balance owed TO the customer. Conflating the two
// would make a single customer row ambiguous about which direction the money moves.
//
// CORRECTED DESIGN (this replaces an earlier version of this comment/model that had two mistakes,
// caught in independent review before any production use): there is no "complete a service and
// automatically earn 20% back" mechanic. Credits only ever enter a wallet through an explicit,
// authorized PROMO_GRANT (platform-admin-only, never self-service) or a RESTORED reversal of a
// redemption whose booking was cancelled. floor(price/50)*10 is a REDEMPTION CAP (the most credit
// a customer may apply against one booking's price), not an earn rate — see
// CustomerCreditsService.computeMaxRedeemable.
//
// Lot-based ledger, not a cached balance counter: there is no `balance` column anywhere. Every
// PROMO_GRANT and RESTORED row is a "lot" carrying its own `remainingAmount` (how much of that
// specific grant is still unspent) and optional `expiresAt`. A customer's spendable balance and
// redemption eligibility are both computed live, at query time, as the sum of remainingAmount
// over lots that are not expired — so an expired grant is mechanically unspendable and simply
// excluded from every read, rather than requiring a sweep job to "deactivate" it, and a cached
// number can never drift from what the ledger actually supports. See
// CustomerCreditsService.getBalance/redeemUpTo for the exact queries.
enum CreditTransactionType {
  // An authorized, auditable grant of promotional credit — see fundingSource/campaignRef/
  // expiresAt below. The ONLY way new spendable value enters a wallet in this product (besides
  // RESTORED). Never self-service — see AdminCreditsController's PLATFORM_ADMIN-only route.
  PROMO_GRANT
  // Applied against a booking's price at creation time, reducing what the customer pays online.
  // Drawn from one or more still-valid PROMO_GRANT/RESTORED lots (soonest-expiring first).
  REDEEMED
  // A REDEEMED amount returned to the customer because the booking that redeemed it was cancelled
  // before the service happened. Deliberately minted as a brand-new, never-expiring lot rather
  // than crediited back to whichever original lot(s) funded the redemption — a customer should
  // never lose restored money to an expiry clock that kept ticking while it was tied up in a
  // booking through no fault of theirs.
  RESTORED
  // Reserved for a future admin correction tool — never written by any code in this phase, and
  // never a substitute for PROMO_GRANT as the normal promotional-credit mechanism.
  MANUAL_ADJUSTMENT
}

// FastQue subsidizes redeemed credits it funded itself; a future SHOP_FUNDED grant (a shop
// funding its own promotion) would mean the shop simply receives less, and FastQue owes it
// nothing for that portion — see PlatformShopSubsidyEntry and
// CustomerCreditsService.redeemUpTo's fundingSource-aware subsidy computation. Only
// FASTQUE_FUNDED is ever actually produced by any code in this phase; SHOP_FUNDED exists so that
// future capability doesn't require a schema change.
enum CreditFundingSource {
  FASTQUE_FUNDED
  SHOP_FUNDED
}

// The anchor row a customer's credit transactions hang off; carries no balance of its own (see
// the lot-based design note above) — it exists so CustomerCreditTransaction has a stable,
// per-customer id to key off, and so a customer with zero credit history still has an
// unambiguous "no rows yet" (not "row with balance 0") represented state.
model CustomerCreditAccount {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions CustomerCreditTransaction[]

  @@map("customer_credit_accounts")
}

// Append-only — nothing in CustomerCreditsService ever deletes a row here. The one field that DOES
// get updated in place after creation is `remainingAmount` on a PROMO_GRANT/RESTORED lot, as
// later REDEEMED transactions consume from it — the row itself, and every other field, never
// changes once written, so the full history of what happened is always reconstructable.
model CustomerCreditTransaction {
  id              String                @id @default(uuid())
  accountId       String
  account         CustomerCreditAccount @relation(fields: [accountId], references: [id])
  type            CreditTransactionType
  // Always positive; `type` alone says direction (PROMO_GRANT/RESTORED add, REDEEMED subtracts) —
  // never a signed value, so a display bug can't silently flip a debit into a credit.
  amount          Decimal               @db.Decimal(10, 2)
  // Meaningful only for PROMO_GRANT and RESTORED rows (the "lots" — see the model-group doc
  // comment above): how much of this specific grant/restoration has not yet been consumed by a
  // later REDEEMED transaction. Null for REDEEMED/MANUAL_ADJUSTMENT rows, which never themselves
  // hold spendable balance. Decrements as redemptions draw from this lot; never goes negative
  // (every consuming update is guarded — see CustomerCreditsService.consumeLots).
  remainingAmount Decimal?              @db.Decimal(10, 2)
  bookingId       String?
  booking         Booking?              @relation(fields: [bookingId], references: [id])
  // Free-text/opaque reference to whatever campaign or promotion authorized a PROMO_GRANT — this
  // product does not (yet) have a real Campaign table, so this is intentionally not a foreign key.
  campaignRef     String?
  fundingSource   CreditFundingSource?
  // Only ever set on a PROMO_GRANT lot; null means "never expires". See the model-group doc
  // comment above for how expiry is actually enforced (live query filter, not a sweep).
  expiresAt       DateTime?
  // Required and unique for a PROMO_GRANT (the admin-facing grant endpoint always supplies the
  // same value it required as the request's Idempotency-Key header, so the two can never drift) —
  // a second grant attempt with the same key is a retried request, not a second grant. Null for
  // every other transaction type, whose own idempotency is structurally guaranteed elsewhere (a
  // booking can only be created/cancelled once per real attempt — see BookingsController's
  // existing @Idempotent() interceptor and the booking status state machine).
  idempotencyKey  String?               @unique
  // Why this transaction happened — required for PROMO_GRANT (an admin must always say why),
  // optional elsewhere.
  reason          String?
  note            String?
  createdAt       DateTime              @default(now())

  @@index([accountId, createdAt])
  @@index([bookingId])
  @@map("customer_credit_transactions")
}

enum SubsidyLedgerStatus {
  OUTSTANDING
  SETTLED
  // The booking that created this entry was cancelled before the service happened — FastQue never
  // actually owed the shop this amount, so the entry is voided rather than deleted (an auditable
  // "this was reversed," not silence).
  VOIDED
}

// FastQue subsidizes redeemed credits, not the shop — a shop is always paid its full listed
// price for a completed service. When a customer redeems credits against a booking, this is the
// auditable record of what FastQue owes that shop to make up the difference. One row per booking
// that redeemed credits (never aggregated across bookings), so each is independently traceable
// back to the exact redemption that created it.
model PlatformShopSubsidyEntry {
  id        String              @id @default(uuid())
  salonId   String
  salon     Salon               @relation(fields: [salonId], references: [id])
  bookingId String              @unique
  booking   Booking             @relation(fields: [bookingId], references: [id])
  amount    Decimal             @db.Decimal(10, 2)
  status    SubsidyLedgerStatus @default(OUTSTANDING)
  createdAt DateTime            @default(now())
  voidedAt  DateTime?
  settledAt DateTime?

  @@index([salonId, status])
  @@map("platform_shop_subsidy_entries")
}

model QueueEntry {
  id          String           @id @default(uuid())
  salonId     String
  salon       Salon            @relation(fields: [salonId], references: [id])
  // Unique (not just indexed): checkIn()'s duplicate guard used to be a plain findFirst read
  // before the create, with no DB-level backstop — two concurrent check-in requests for the same
  // booking (a double-tap, or a client retry with a fresh idempotency key) could each pass that
  // read before either committed, producing two QueueEntry rows for one booking. Postgres allows
  // multiple NULLs through a unique index, so this does not constrain walk-ins (bookingId always
  // null for those).
  bookingId   String?          @unique
  booking     Booking?         @relation(fields: [bookingId], references: [id])
  customerId  String?
  customer    User?            @relation(fields: [customerId], references: [id])
  // Not listed explicitly in DATABASE.md's original field list — added because API.md's walk-in
  // join endpoint accepts an optional serviceId with no other field to hold it before a
  // ServiceSession exists. Documented back into DATABASE.md as a Phase 1 addition, not a
  // contradiction of it. Nullable: an appointment-sourced entry can resolve its service via the
  // linked Booking instead.
  serviceId   String?
  service     Service?         @relation(fields: [serviceId], references: [id])
  source      QueueEntrySource
  tokenNumber Int
  status      QueueEntryStatus @default(WAITING)

  assignedStaffId String?
  assignedStaff   SalonStaff? @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  assignedChairId String?
  assignedChair   Chair?      @relation("AssignedChair", fields: [assignedChairId], references: [id])

  // Live Queue operations mission — the contact details the customer gave when joining (a
  // per-entry snapshot: FastQue stores no customer name, and an account may have no phone, so the
  // join flow collects both). Only ever returned by owner/staff dashboard reads and to the entry's
  // own customer; never by the public queue status APIs, realtime payloads or logs.
  contactName          String?
  contactPhone         String?
  // Anonymous queue tickets are controlled by an unguessable 256-bit capability.
  // Only its SHA-256 digest is stored. No login account is created from an unverified number.
  guestAccessHash      String?    @unique @db.VarChar(64)
  guestAccessExpiresAt DateTime?  @db.Timestamptz(6)
  guestExpoPushToken    String?    @db.VarChar(255)
  // Durable once-only queue arrival prompt. Customer claims are NOT verified shop arrivals.
  arrivalPromptSentAt       DateTime? @db.Timestamptz(6)
  customerArrivalResponse   Boolean?
  customerArrivalResponseAt DateTime? @db.Timestamptz(6)
  // Owner-operations mission — an operator-created Live Queue entry for someone at the shop who
  // has no FastQue account (customerId stays NULL; contactName/contactPhone hold what the shop
  // typed in). createdByUserId is the operator; preferredStaffId is an optional soft request that
  // the automatic allocator honors (plain columns, no relations).
  createdByUserId      String?
  preferredStaffId     String?
  // Authoritative arrival acknowledgement, instead of widening the status enum: an appointment
  // check-in sets it at creation (arrival was already confirmed), a remote/QR join starts null and
  // staff mark it, and assigning an entry to a chair implicitly sets it (the person is in the shop).
  arrivedAt            DateTime?
  joinedAt             DateTime  @default(now())
  calledAt             DateTime?
  // Owner-operations corrective mission: when a barber + chair were reserved for this customer.
  // An ASSIGNED customer is status CALLED with assignedStaffId/assignedChairId set and NO
  // serviceStartedAt and NO ServiceSession; the barber's explicit start moves it to IN_SERVICE.
  // Two partial unique indexes (migration 20261014000000) stop one barber or one chair being held
  // by two assigned customers at once.
  assignedAt           DateTime?
  serviceStartedAt     DateTime?
  serviceCompletedAt   DateTime?
  estimatedWaitMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceSessions ServiceSession[]
  serviceUsages   ServiceUsage[]
  // Live-visit add-on mission: services the customer added at the shop after joining/check-in.
  // addOnMinutes is the cached SUM(addOns.durationMinutes), written in the same transaction as the
  // add-on rows, so every ETA/reservation read can include it without a join.
  addOns          QueueEntryAddOn[]
  addOnMinutes    Int               @default(0)

  @@map("queue_entries")
}

// Live-visit add-on mission (17 Nov 2026): an extra service the customer chose at the shop, on top of
// the service(s) picked when joining the queue or booking. name/duration/price are snapshots taken
// when it was added, so later catalogue edits never rewrite what this visit actually was or costs.
model QueueEntryAddOn {
  id              String     @id @default(uuid())
  queueEntryId    String
  queueEntry      QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service    @relation(fields: [serviceId], references: [id])
  name            String
  durationMinutes Int
  price           Decimal    @db.Decimal(10, 2)
  addedByUserId   String?
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)

  @@unique([queueEntryId, serviceId])
  @@map("queue_entry_add_ons")
}

// The concurrency-critical model. See the two partial unique indexes noted at the top of this
// file and enforced in the SQL migration — Prisma schema DSL cannot express them declaratively.
model ServiceSession {
  id           String               @id @default(uuid())
  queueEntryId String
  queueEntry   QueueEntry           @relation(fields: [queueEntryId], references: [id])
  staffId      String
  staff        SalonStaff           @relation(fields: [staffId], references: [id])
  chairId      String
  chair        Chair                @relation(fields: [chairId], references: [id])
  serviceId    String
  service      Service              @relation(fields: [serviceId], references: [id])
  status       ServiceSessionStatus @default(ACTIVE)
  startedAt    DateTime             @default(now())
  endedAt      DateTime?
  createdAt    DateTime             @default(now())

  @@map("service_sessions")
}

// ---------- Payments ----------

model Payment {
  id                String          @id @default(uuid())
  bookingId         String?
  booking           Booking?        @relation(fields: [bookingId], references: [id])
  type              PaymentType
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR")
  provider          PaymentProvider @default(RAZORPAY)
  providerOrderId   String?
  providerPaymentId String?         @unique
  idempotencyKey    String          @unique
  status            PaymentStatus   @default(CREATED)
  webhookVerifiedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  refunds           Refund[]
  ledgerSettlements CustomerLedgerEntry[]

  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id])
  amount           Decimal      @db.Decimal(10, 2)
  reason           String?
  providerRefundId String?
  status           RefundStatus @default(INITIATED)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("refunds")
}

model CustomerLedgerEntry {
  id                 String       @id @default(uuid())
  customerId         String
  customer           User         @relation(fields: [customerId], references: [id])
  salonId            String
  salon              Salon        @relation(fields: [salonId], references: [id])
  bookingId          String?
  booking            Booking?     @relation(fields: [bookingId], references: [id])
  amount             Decimal      @db.Decimal(10, 2)
  reason             LedgerReason
  status             LedgerStatus @default(OUTSTANDING)
  settledByPaymentId String?
  settledByPayment   Payment?     @relation(fields: [settledByPaymentId], references: [id])
  createdAt          DateTime     @default(now())
  settledAt          DateTime?

  @@map("customer_ledger_entries")
}

// Generic idempotency guard for mutating endpoints (bookings, queue join, payment init,
// cancellation) and deterministic system-triggered transitions (e.g. the no-show sweep job).
model IdempotencyKey {
  key              String   @id
  endpoint         String
  requestHash      String
  responseSnapshot Json?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@map("idempotency_keys")
}

// ---------- Reviews ----------

model Review {
  id            String   @id @default(uuid())
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id])
  customerId    String
  customer      User     @relation(fields: [customerId], references: [id])
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id])
  rating        Int
  comment       String?
  ownerResponse String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("reviews")
}

// Owner-maintained links to external review profiles. No external provider data is mirrored or
// fetched in V1; a configured link is exposed as LINK_ONLY, never as a connected review feed.
model SalonReviewProfile {
  salonId      String   @id
  salon        Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  googleUrl    String?  @db.VarChar(500)
  facebookUrl  String?  @db.VarChar(500)
  instagramUrl String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@map("salon_review_profiles")
}

// ---------- Verification (Phase 18 — foundation only) ----------
//
// Deliberately NOT identity/KYC verification: no Aadhaar/PAN/passport collection, no third-party
// KYC provider, no automated document verification. "Evidence" is owner-supplied free text plus a
// list of already-hosted https links (same "URL-based, no object storage configured" convention as
// Salon photos and SalonStaff.photoUrl) that a human PLATFORM_ADMIN reviews manually. The public
// badge this unlocks must always read as "profile evidence reviewed by BarberCue," never "identity
// verified" — see VERIFICATION_BADGE_CAPTION in packages/shared/src/constants, the single place
// that wording lives so it can never drift between surfaces.
//
// One row per subject (salonId or staffId, whichever applies — never both), enforced by the two
// @@unique constraints below relying on Postgres's default NULLS DISTINCT behavior: a row with
// salonId set is unique on that value, while any number of PROFESSIONAL-type rows (salonId always
// NULL) coexist freely, and symmetrically for staffId. `status` holds the CURRENT state only —
// "NOT_SUBMITTED" is never stored, it is simply the absence of a row for that subject, the same
// "no row = default" convention used elsewhere in this schema (NotificationPreference,
// StaffWorkingHours). Every transition (submit, start review, approve, reject, resubmit) also
// writes an AuditLog entry, so full history survives even though this row only ever holds the
// latest state — reusing the existing generic audit trail rather than inventing a parallel one.
enum VerificationSubjectType {
  SHOP
  PROFESSIONAL
}

enum VerificationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model VerificationRequest {
  id            String                  @id @default(uuid())
  subjectType   VerificationSubjectType
  salonId       String?
  salon         Salon?                  @relation(fields: [salonId], references: [id])
  staffId       String?
  staff         SalonStaff?             @relation(fields: [staffId], references: [id])
  status        VerificationStatus      @default(SUBMITTED)
  evidenceNotes String?
  evidenceUrls  String[]

  submittedByUserId String
  submittedBy       User     @relation("VerificationSubmitter", fields: [submittedByUserId], references: [id])
  submittedAt       DateTime @default(now())

  reviewedByAdminId String?
  reviewedByAdmin   User?     @relation("VerificationReviewer", fields: [reviewedByAdminId], references: [id])
  reviewNotes       String?
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salonId])
  @@unique([staffId])
  @@map("verification_requests")
}

// Owner-submitted coordinates are proposals, not public location updates. Only a distinct global
// platform admin may approve a proposal; approval then copies the coordinates to Salon.lat/lng.
// Keeping proposals separately preserves review history and ensures EXIF or owner-provided GPS is
// never treated as proof by itself.
model SalonLocationProposal {
  id                String                      @id @default(uuid())
  salonId           String
  salon             Salon                       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  latitude          Float
  longitude         Float
  source            SalonLocationSource
  status            SalonLocationProposalStatus @default(PENDING)
  // PostgreSQL NULLS DISTINCT plus this unique pair permits unlimited reviewed history while
  // allowing only the value 1 to occupy the pending slot for one salon at a time.
  pendingSlot       Int?
  submittedByUserId String
  submittedBy       User                        @relation("SalonLocationSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  submittedAt       DateTime                    @default(now())
  reviewedByAdminId String?
  reviewedByAdmin   User?                       @relation("SalonLocationReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNote        String?                     @db.VarChar(500)

  @@unique([salonId, pendingSlot])
  @@index([status, submittedAt, id])
  @@index([salonId, submittedAt])
  @@map("salon_location_proposals")
}

// ---------- Notifications ----------

model Notification {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  type      String
  payload   Json?
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  // Phase 11 additions — an IN_APP notification is read/unread (null = unread) rather than the
  // PENDING/SENT/FAILED delivery-attempt lifecycle SMS/PUSH/EMAIL rows use; deepLink is a client
  // route (e.g. "owner/bookings/:id") the notification-center UI navigates to on tap, optional
  // since not every notification type has one obvious destination.
  readAt    DateTime?
  deepLink  String?

  @@map("notifications")
}

// ---------- Audit ----------

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

// Salon-scoped operational stock. It is deliberately separate from invoices and the append-only
// customer/invoice payment ledgers. Stock changes only through immutable movements; PostgreSQL
// serializes concurrent changes on the product row and rejects any movement that would go negative.
model InventoryCategory {
  id             String   @id @default(uuid())
  salonId        String
  salon          Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  name           String   @db.VarChar(80)
  normalizedName String   @db.VarChar(80)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  products InventoryProduct[]
  serviceRules ServiceProductRule[]

  @@unique([id, salonId])
  @@unique([salonId, normalizedName])
  @@map("inventory_categories")
}

model InventorySupplier {
  id             String   @id @default(uuid())
  salonId        String
  salon          Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  name           String   @db.VarChar(120)
  normalizedName String   @db.VarChar(120)
  contactName    String?  @db.VarChar(120)
  phone          String?  @db.VarChar(40)
  email          String?  @db.VarChar(254)
  notes          String?  @db.VarChar(500)
  // Inventory Phase 3: days from ordering to delivery; null = the shop's default lead time.
  leadTimeDays   Int?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  products  InventoryProduct[]
  movements InventoryMovement[]

  @@unique([id, salonId])
  @@unique([salonId, normalizedName])
  @@map("inventory_suppliers")
}

model InventoryProduct {
  id               String             @id @default(uuid())
  salonId          String
  salon            Salon              @relation(fields: [salonId], references: [id], onDelete: Restrict)
  categoryId       String?
  category         InventoryCategory? @relation(fields: [categoryId, salonId], references: [id, salonId], onDelete: Restrict)
  supplierId       String?
  supplier         InventorySupplier? @relation(fields: [supplierId, salonId], references: [id, salonId], onDelete: Restrict)
  name             String             @db.VarChar(120)
  normalizedName   String             @db.VarChar(120)
  sku              String?            @db.VarChar(80)
  unit             InventoryUnit
  stockOnHand      Decimal            @default(0) @db.Decimal(12, 3)
  averageUnitCost  Decimal            @default(0) @db.Decimal(12, 2)
  reorderThreshold Decimal            @default(0) @db.Decimal(12, 3)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)
  // Inventory Phase 1: optional link to the Global Product Master (the salon keeps its own stock,
  // costs and prices), which shelf the stock is on, and per-salon commercial details.
  globalProductId      String?
  globalProduct        GlobalProduct? @relation(fields: [globalProductId], references: [id], onDelete: Restrict)
  usage                StockUsage     @default(PROFESSIONAL)
  sellingPrice         Decimal?       @db.Decimal(12, 2)
  storageLocation      String?        @db.VarChar(80)
  minimumOrderQuantity Decimal?       @db.Decimal(12, 3)
  // Inventory Phase 2: what one counted piece/pack/box contains (1 bottle = 195 ml).
  contentSize          Decimal?       @db.Decimal(12, 3)
  contentUnit          InventoryUnit?

  movements         InventoryMovement[]
  shopListing       ShopListing?
  shopOrderItems    ShopOrderItem[]
  recipeDefaults    ServiceProductRule[]
  serviceUsageItems ServiceUsageItem[]
  alerts            InventoryAlert[]
  homeOfferingProducts HomeOfferingProduct[]
  homeProductUses   HomeProductUse[]

  @@unique([id, salonId])
  @@unique([salonId, sku])
  @@unique([salonId, globalProductId, usage])
  @@index([globalProductId])
  @@index([salonId, isActive, normalizedName])
  @@index([salonId, categoryId])
  @@index([salonId, stockOnHand])
  @@map("inventory_products")
}

model InventoryMovement {
  id                   String                @id @default(uuid())
  salonId              String
  salon                Salon                 @relation(fields: [salonId], references: [id], onDelete: Restrict)
  productId            String
  product              InventoryProduct      @relation(fields: [productId, salonId], references: [id, salonId], onDelete: Restrict)
  supplierId           String?
  supplier             InventorySupplier?    @relation(fields: [supplierId, salonId], references: [id, salonId], onDelete: Restrict)
  actorUserId          String
  actor                User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  kind                 InventoryMovementKind
  quantityDelta        Decimal               @db.Decimal(12, 3)
  unitCost             Decimal?              @db.Decimal(12, 2)
  stockAfter           Decimal               @default(0) @db.Decimal(12, 3)
  averageUnitCostAfter Decimal               @default(0) @db.Decimal(12, 2)
  reason               String?               @db.VarChar(300)
  reference            String?               @db.VarChar(120)
  idempotencyKey       String                @db.VarChar(128)
  requestHash          String                @db.VarChar(64)
  recordedAt           DateTime              @default(now()) @db.Timestamptz(6)
  // Inventory Phase 1: batch/lot and expiry recorded on incoming stock; a shelf transfer's two
  // entries share one transferGroupId.
  batchNumber          String?               @db.VarChar(60)
  expiryDate           DateTime?             @db.Date
  transferGroupId      String?               @db.Uuid
  // Inventory Phase 2: the service usage line this entry deducted, or the correction that undid it.
  serviceUsageItem         ServiceUsageItem?     @relation("ServiceUsageMovement")
  serviceUsageReversalItem ServiceUsageItem?     @relation("ServiceUsageReversalMovement")

  @@unique([salonId, idempotencyKey])
  @@index([salonId, recordedAt, id])
  @@index([productId, recordedAt, id])
  @@index([salonId, kind, recordedAt])
  @@map("inventory_movements")
}

// ---------- Global Product Master (Inventory Phase 1) ----------
// One shared catalog of products identified by barcode. Salons keep their own stock, costs and
// prices on InventoryProduct. A salon's submission stays PENDING (usable by that salon only) until
// a FastQue admin verifies it; nothing is published to other salons unverified.
model GlobalProduct {
  id                 String                    @id @default(uuid())
  name               String                    @db.VarChar(160)
  normalizedName     String                    @db.VarChar(160)
  brand              String?                   @db.VarChar(120)
  manufacturer       String?                   @db.VarChar(160)
  category           String?                   @db.VarChar(80)
  subcategory        String?                   @db.VarChar(80)
  description        String?                   @db.VarChar(1000)
  packSize           Decimal?                  @db.Decimal(12, 3)
  packUnit           InventoryUnit?
  mrp                Decimal?                  @db.Decimal(12, 2)
  currency           String?                   @db.VarChar(3)
  hsnCode            String?                   @db.VarChar(8)
  gstRatePercent     Decimal?                  @db.Decimal(5, 2)
  productType        ProductType               @default(BOTH)
  dataSource         ProductDataSource
  sourceReference    String?                   @db.VarChar(300)
  sourceLicense      String?                   @db.VarChar(80)
  verificationStatus ProductVerificationStatus @default(PENDING)
  submittedBySalonId String?
  submittedBySalon   Salon?                    @relation("GlobalProductSubmissions", fields: [submittedBySalonId], references: [id], onDelete: SetNull)
  createdByUserId    String
  createdBy          User                      @relation("GlobalProductCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedByUserId   String?
  reviewedBy         User?                     @relation("GlobalProductReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?                 @db.Timestamptz(6)
  reviewNote         String?                   @db.VarChar(300)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(6)
  // Inventory master upload: GLOBAL products are offered to every salon; SHOP products are private
  // to ownerSalonId (a database check keeps the two columns consistent). Neither ever becomes stock
  // in a salon by itself: a salon only stocks a product through its own InventoryProduct row.
  visibility         CatalogVisibility         @default(GLOBAL)
  ownerSalonId       String?
  ownerSalon         Salon?                    @relation("GlobalProductOwnerSalon", fields: [ownerSalonId], references: [id], onDelete: Restrict)
  // The supplier's / file's own product code (e.g. "FQ-TST-001") - identity for rows without a barcode.
  externalRef        String?                   @db.VarChar(80)
  // Free-text variant / size exactly as supplied ("100 ml", "Shade 4.0"); never merged across variants.
  variantText        String?                   @db.VarChar(80)
  // Synthetic/test rows (e.g. demo barcodes). Kept out of production unless explicitly allowed.
  isTestData         Boolean                   @default(false)
  uploadJobId        String?                   @db.Uuid
  uploadJob          InventoryUploadJob?       @relation(fields: [uploadJobId], references: [id], onDelete: SetNull)

  barcodes          GlobalProductBarcode[]
  images            GlobalProductImage[]
  inventoryProducts InventoryProduct[]
  changeRequests    CatalogChangeRequest[]
  shopListings      ShopListing[]
  shopOrderItems    ShopOrderItem[]
  wishlistedBy      ShopWishlistItem[]
  commerceListings  CommerceListing[]

  @@index([verificationStatus, createdAt])
  @@index([normalizedName])
  @@index([submittedBySalonId])
  @@index([visibility, ownerSalonId])
  @@index([category])
  @@index([uploadJobId])
  @@map("global_products")
}

// Barcodes are text, never numbers (leading zeros matter). `code` is the canonical form from
// normalizeBarcode (retail barcodes as 14-digit GTINs), unique across the catalog.
model GlobalProductBarcode {
  id        String        @id @default(uuid())
  productId String
  product   GlobalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String        @unique @db.VarChar(64)
  display   String        @db.VarChar(64)
  format    BarcodeFormat
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  @@index([productId])
  @@map("global_product_barcodes")
}

model GlobalProductImage {
  id        String        @id @default(uuid())
  productId String
  product   GlobalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String        @db.VarChar(500)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  @@index([productId, sortOrder])
  @@map("global_product_images")
}

// ---------- Inventory master uploads (admin Excel/CSV) ----------
// One row per uploaded file. The parsed, normalized rows are kept on the job at preview time so the
// commit imports exactly what the admin previewed (no second upload). Row problems are separate rows
// so they can be paged and downloaded as a CSV report.
model InventoryUploadJob {
  id                 String                  @id @default(uuid()) @db.Uuid
  uploadedByUserId   String
  uploadedBy         User                    @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  fileName           String                  @db.VarChar(255)
  fileType           InventoryUploadFileType
  fileSizeBytes      Int
  fileSha256         String                  @db.VarChar(64)
  sheetName          String?                 @db.VarChar(120)
  headerRow          Int?
  status             InventoryUploadStatus   @default(PREVIEWED)
  columnMapping      Json?
  parsedRows         Json?
  sourceReference    String?                 @db.VarChar(300)
  sourceLicense      String?                 @db.VarChar(80)
  markAsTestData     Boolean                 @default(false)
  totalRows          Int                     @default(0)
  createdCount       Int                     @default(0)
  linkedCount        Int                     @default(0)
  unchangedCount     Int                     @default(0)
  skippedCount       Int                     @default(0)
  errorCount         Int                     @default(0)
  warningCount       Int                     @default(0)
  reviewCount        Int                     @default(0)
  embeddedImageCount Int                     @default(0)
  failureMessage     String?                 @db.VarChar(500)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  startedAt          DateTime?               @db.Timestamptz(6)
  completedAt        DateTime?               @db.Timestamptz(6)

  issues   InventoryUploadError[]
  products GlobalProduct[]

  @@index([createdAt, id])
  @@index([status, createdAt])
  @@index([fileSha256])
  @@map("inventory_upload_jobs")
}

model InventoryUploadError {
  id        String                       @id @default(uuid()) @db.Uuid
  jobId     String                       @db.Uuid
  job       InventoryUploadJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rowNumber Int
  severity  InventoryUploadIssueSeverity
  code      String                       @db.VarChar(60)
  field     String?                      @db.VarChar(60)
  message   String                       @db.VarChar(500)
  rawValue  String?                      @db.VarChar(300)
  // Which phase found it: PREVIEW (file checks) or COMMIT (what happened when it was imported).
  phase     String                       @default("PREVIEW") @db.VarChar(10)
  createdAt DateTime                     @default(now()) @db.Timestamptz(6)

  @@index([jobId, phase, rowNumber])
  @@index([jobId, severity])
  @@map("inventory_upload_errors")
}

// An owner asking FastQue to correct a master product (owners never edit the shared catalog).
model CatalogChangeRequest {
  id                String                     @id @default(uuid()) @db.Uuid
  salonId           String
  salon             Salon                      @relation(fields: [salonId], references: [id], onDelete: Restrict)
  requestedByUserId String
  requestedBy       User                       @relation("CatalogChangeRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  globalProductId   String?
  globalProduct     GlobalProduct?             @relation(fields: [globalProductId], references: [id], onDelete: SetNull)
  barcode           String?                    @db.VarChar(64)
  message           String                     @db.VarChar(1000)
  proposedFields    Json?
  status            CatalogChangeRequestStatus @default(OPEN)
  resolvedByUserId  String?
  resolvedBy        User?                      @relation("CatalogChangeResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt        DateTime?                  @db.Timestamptz(6)
  resolutionNote    String?                    @db.VarChar(500)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([salonId, createdAt])
  @@map("catalog_change_requests")
}

// ---------- FastQue Marketplace ----------
// A salon sells one of ITS inventory products (which must be linked to a master catalog product).
// Listing ≠ stock: quantities always come from inventory_products; an order reserves stock while it
// is open and the sale leaves stock through the normal ledger when the customer collects it.
model ShopListing {
  id                 String            @id @default(uuid()) @db.Uuid
  salonId            String
  salon              Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  inventoryProductId String            @unique
  inventoryProduct   InventoryProduct  @relation(fields: [inventoryProductId], references: [id], onDelete: Restrict)
  globalProductId    String
  globalProduct      GlobalProduct     @relation(fields: [globalProductId], references: [id], onDelete: Restrict)
  price              Decimal           @db.Decimal(12, 2)
  compareAtPrice     Decimal?          @db.Decimal(12, 2)
  pickupEnabled      Boolean           @default(true)
  deliveryEnabled    Boolean           @default(false)
  maxPerOrder        Int               @default(5)
  status             ShopListingStatus @default(PENDING_APPROVAL)
  reviewNote         String?           @db.VarChar(300)
  reviewedByUserId   String?
  reviewedBy         User?             @relation("ShopListingReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?         @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  orderItems ShopOrderItem[]

  @@index([globalProductId, status])
  @@index([salonId, status])
  @@index([status, updatedAt])
  @@map("shop_listings")
}

model ShopOrder {
  id               String             @id @default(uuid()) @db.Uuid
  orderNumber      String             @unique @db.VarChar(20)
  salonId          String
  salon            Salon              @relation(fields: [salonId], references: [id], onDelete: Restrict)
  customerUserId   String?
  customer         User?              @relation("ShopOrderCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  contactName      String             @db.VarChar(120)
  contactPhone     String             @db.VarChar(20)
  contactEmail     String?            @db.VarChar(254)
  note             String?            @db.VarChar(300)
  // SHA-256 of the secret in a guest's order link; the secret itself is never stored.
  accessTokenHash  String             @db.VarChar(64)
  idempotencyKey   String             @unique @db.VarChar(128)
  status           ShopOrderStatus    @default(PLACED)
  fulfillment      ShopFulfillment    @default(PICKUP)
  paymentMethod    ShopPaymentMethod  @default(PAY_AT_SALON)
  paymentStatus    ShopPaymentStatus  @default(UNPAID)
  currency         String             @default("INR") @db.VarChar(3)
  subtotal         Decimal            @db.Decimal(12, 2)
  discountTotal    Decimal            @default(0) @db.Decimal(12, 2)
  total            Decimal            @db.Decimal(12, 2)
  // A PLACED order the salon has not accepted by then stops holding stock and expires.
  acceptBy         DateTime           @db.Timestamptz(6)
  placedAt         DateTime           @default(now()) @db.Timestamptz(6)
  acceptedAt       DateTime?          @db.Timestamptz(6)
  readyAt          DateTime?          @db.Timestamptz(6)
  completedAt      DateTime?          @db.Timestamptz(6)
  cancelledAt      DateTime?          @db.Timestamptz(6)
  cancelReason     String?            @db.VarChar(300)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)

  items  ShopOrderItem[]
  events ShopOrderEvent[]

  @@index([salonId, status, placedAt])
  @@index([customerUserId, placedAt])
  @@index([status, acceptBy])
  @@map("shop_orders")
}

// Snapshot of what was bought: later listing/catalog edits never change a past order.
model ShopOrderItem {
  id                 String           @id @default(uuid()) @db.Uuid
  orderId            String           @db.Uuid
  order              ShopOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  FLAT
}

enum OfferAudience {
  ALL
  NEW
  REPEAT
  INACTIVE
}

// Who actually cancelled a booking, recorded at cancellation time from the authenticated actor —
// never inferred afterwards from the booking's status. NULL on a row means "not recorded": every
// cancellation written before this column existed, which analytics reports as UNKNOWN (or, for the
// one code path that provably only ever wrote the customer's own id, CUSTOMER — see
// DashboardCancellationAnalyticsService.resolveActor).
enum CancellationActor {
  CUSTOMER
  OWNER
  STAFF
  SYSTEM
  ADMIN
}

enum QueueEntrySource {
  WALK_IN
  APPOINTMENT
}

enum QueueEntryStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW
  CANCELLED
  // Added for the WAITING-day-rollover sweep (see QueueEntryExpiryService.markStaleWaitingExpired):
  // a WAITING entry never called/assigned/cancelled by the end of its salon-local join day. Distinct
  // from NO_SHOW, which only applies after a customer was actually CALLED and didn't respond.
  EXPIRED
}

enum ServiceSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ChargeType {
  FLAT
  PERCENTAGE
}

